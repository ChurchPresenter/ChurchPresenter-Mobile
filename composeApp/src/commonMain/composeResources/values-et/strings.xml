    <string name="connect_setup_step1_title">Ava arvutis ChurchPresenter</string>
    <string name="connect_setup_step1_body">Käivita ChurchPresenter töölauarakendus ja veendu, et see töötab samas Wi-Fi võrgus kui see seade.</string>
    <string name="connect_setup_step2_title">Kuva ühenduse QR-kood</string>
    <string name="connect_setup_step2_body">Töölauarakenduses mine Seaded → Mobiil → ja vajuta \"Show QR Code\". Ekraanile ilmub ühenduse üksikasjadega QR-kood.</string>
