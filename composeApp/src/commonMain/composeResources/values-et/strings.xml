    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Usalda serveri sertifikaat</string>
    <string name="cert_setup_subtitle">Vajalik ühekordne seadistus</string>
    <string name="cert_setup_intro">ChurchPresenter kasutab turvaliseks suhtluseks privaatset HTTPS-sertifikaati. Pead selle korra installima, et sinu seade ühendust usaldaks.</string>
    <string name="cert_setup_scan_title">Skaneeri sertifikaadi QR-kood</string>
    <string name="cert_setup_scan_desktop_hint">ChurchPresenter töölauarakenduses: Seaded → Server → vajuta \"Download Cert\", et kuvada QR-kood.</string>
    <string name="cert_setup_scan_button">Skaneeri QR-kood</string>
    <string name="cert_setup_scan_or_divider">või kasuta salvestatud aadressi</string>
    <string name="cert_setup_url_scanned">✓ URL skaneeritud</string>
    <string name="cert_setup_url_label">Sertifikaadi URL</string>
    <string name="cert_setup_open_button">Ava sertifikaadi URL</string>
    <string name="cert_setup_step2_ios_title">iOS — installi profiil</string>
    <string name="cert_setup_step2_ios_body">Safari palub laadida alla konfiguratsiooniprofiili. Vajuta Luba, seejärel mine Seaded → Üldine → VPN &amp; seadmehaldus, vajuta ChurchPresenter ja installi.</string>
    <string name="cert_setup_step3_ios_title">iOS — usalda sertifikaat</string>
    <string name="cert_setup_step3_ios_body">Seaded → Üldine → Teave → Sertifikaadi usaldusseaded → luba täielik usaldus ChurchPresenter CA jaoks.</string>
    <string name="cert_setup_step2_android_title">Android — installi sertifikaat</string>
    <string name="cert_setup_step2_android_body">Chrome laadib alla .crt faili. Vajuta seda allalaadimiste teavituses, vali \"CA-sertifikaat\" ja anna sellele nimi, näiteks \"ChurchPresenter\".</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ \"Ei saa installida tundmatutest allikatest\"?</string>
    <string name="cert_setup_android_unknown_sources_body">Android võib installi blokeerida, kui sinu brauseril pole lubatud faile installida. Mine Seaded → Rakendused → [sinu brauser] → Installi tundmatuid rakendusi, seejärel luba \"Luba sellest allikast\". Naase siia ja vajuta failile uuesti.</string>
    <string name="cert_setup_fingerprint_title">Kontrolli sõrmejälge (soovituslik)</string>
    <string name="cert_setup_fingerprint_body">Võrdle seda sõrmejälge sellega, mida ChurchPresenter töölauarakendus näitab jaotises Seaded → Server → Sertifikaadi SHA-256. Need peavad kattuma.</string>
    <string name="cert_setup_fingerprint_unavailable">Sõrmejälje nägemiseks ühenda esmalt serveriga</string>
    <string name="cert_setup_done_button">Valmis — sertifikaat installitud</string>
    <string name="cert_setup_skip_button">Jäta praegu vahele</string>
    <string name="cert_setup_skip_note">Saad selle juhendi juurde igal ajal Seadetest naasta.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Ühenda töölauaga</string>
    <string name="connect_setup_subtitle">Vajalik ühekordne seadistus</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile ühendub sinu kohtvõrgus oleva ChurchPresenter töölauarakendusega. Skaneeri töölaual olev QR-kood, et ühendus automaatselt seadistada.</string>
