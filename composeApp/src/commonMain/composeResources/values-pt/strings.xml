    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Confiar no certificado do servidor</string>
    <string name="cert_setup_subtitle">Configuração única necessária</string>
    <string name="cert_setup_intro">O ChurchPresenter usa um certificado HTTPS privado para comunicação segura. Você precisa instalá-lo uma vez para que seu dispositivo confie na conexão.</string>
    <string name="cert_setup_scan_title">Leia o código QR do certificado</string>
    <string name="cert_setup_scan_desktop_hint">No ChurchPresenter para computador: Configurações → Servidor → pressione \"Baixar certificado\" para exibir o código QR.</string>
    <string name="cert_setup_scan_button">Ler código QR</string>
    <string name="cert_setup_scan_or_divider">ou use o endereço salvo</string>
    <string name="cert_setup_url_scanned">✓ URL lida</string>
    <string name="cert_setup_url_label">URL do certificado</string>
    <string name="cert_setup_open_button">Abrir URL do certificado</string>
    <string name="cert_setup_step2_ios_title">iOS — Instale o perfil</string>
    <string name="cert_setup_step2_ios_body">O Safari pedirá para baixar um perfil de configuração. Toque em Permitir, depois vá em Ajustes → Geral → Gerenciamento de VPN e Dispositivo, toque em ChurchPresenter e instale.</string>
    <string name="cert_setup_step3_ios_title">iOS — Confie no certificado</string>
    <string name="cert_setup_step3_ios_body">Ajustes → Geral → Sobre → Ajustes de Confiança do Certificado → ative a confiança total para ChurchPresenter CA.</string>
    <string name="cert_setup_step2_android_title">Android — Instale o certificado</string>
    <string name="cert_setup_step2_android_body">O Chrome baixa o arquivo .crt. Toque nele na notificação de Downloads, escolha \"Certificado CA\" e dê um nome como \"ChurchPresenter\".</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ \"Não é possível instalar de fontes desconhecidas\"?</string>
    <string name="cert_setup_android_unknown_sources_body">O Android pode bloquear a instalação se o seu navegador não tiver permissão para instalar arquivos. Vá em Configurações → Apps → [seu navegador] → Instalar apps desconhecidos, depois ative \"Permitir desta fonte\". Volte aqui e toque no arquivo novamente.</string>
    <string name="cert_setup_fingerprint_title">Verifique a impressão digital (recomendado)</string>
    <string name="cert_setup_fingerprint_body">Compare esta impressão digital com a que o ChurchPresenter para computador mostra em Configurações → Servidor → Certificado SHA-256. Elas devem coincidir.</string>
    <string name="cert_setup_fingerprint_unavailable">Conecte-se ao servidor primeiro para ver a impressão digital</string>
    <string name="cert_setup_done_button">Concluído — Certificado instalado</string>
    <string name="cert_setup_skip_button">Ignorar por enquanto</string>
    <string name="cert_setup_skip_note">Você pode voltar a este guia a qualquer momento nas Configurações.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Conectar ao computador</string>
    <string name="connect_setup_subtitle">Configuração única necessária</string>
    <string name="connect_setup_intro">O ChurchPresenter Mobile conecta-se ao aplicativo ChurchPresenter para computador na sua rede local. Leia o código QR do computador para configurar a conexão automaticamente.</string>
    <string name="connect_setup_skip_button">Ignorar por enquanto</string>
    <string name="connect_setup_done_button">Concluído — Conectado</string>
    <string name="connect_setup_skip_note">Você pode ler o código QR a qualquer momento nas Configurações.</string>
    <string name="connect_setup_step1_title">Abra o ChurchPresenter no seu computador</string>
    <string name="connect_setup_step1_body">Inicie o aplicativo ChurchPresenter para computador e certifique-se de que ele está na mesma rede Wi-Fi que este dispositivo.</string>
    <string name="connect_setup_step2_title">Exiba o código QR de conexão</string>
    <string name="connect_setup_step2_body">No aplicativo para computador vá em Configurações → Mobile → e pressione \"Mostrar código QR\". Um código QR com os detalhes da conexão aparecerá na tela.</string>
    <string name="connect_setup_step3_title">Leia o código QR abaixo</string>
    <string name="connect_setup_step3_body">Toque no botão abaixo para abrir a câmera e ler o código QR exibido no computador. A conexão será configurada automaticamente.</string>
    <string name="connect_setup_scan_button">Ler código QR</string>
    <string name="connect_setup_connected">✓ Conectado a %1$s:%2$s</string>
    <string name="connect_setup_no_camera_note">Nenhuma câmera detectada neste dispositivo. Insira os detalhes da conexão manualmente:</string>
