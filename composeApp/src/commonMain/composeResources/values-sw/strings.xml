    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Amini cheti cha seva</string>
    <string name="cert_setup_subtitle">Usanidi wa mara moja unahitajika</string>
    <string name="cert_setup_intro">ChurchPresenter hutumia cheti cha HTTPS cha faragha kwa mawasiliano salama. Unahitaji kukisakinisha mara moja ili kifaa chako kiamini muunganisho huu.</string>
    <string name="cert_setup_scan_title">Changanua msimbo wa QR wa cheti</string>
    <string name="cert_setup_scan_desktop_hint">Katika ChurchPresenter kwenye kompyuta: Mipangilio → Seva → bonyeza “Download Cert” ili kuonyesha msimbo wa QR.</string>
    <string name="cert_setup_scan_button">Changanua msimbo wa QR</string>
    <string name="cert_setup_scan_or_divider">au tumia anwani iliyohifadhiwa</string>
    <string name="cert_setup_url_scanned">✓ URL imechanganuliwa</string>
    <string name="cert_setup_url_label">URL ya cheti</string>
    <string name="cert_setup_open_button">Fungua URL ya cheti</string>
    <string name="cert_setup_step2_ios_title">iOS — Sakinisha wasifu</string>
    <string name="cert_setup_step2_ios_body">Safari itaomba kupakua wasifu wa usanidi. Gusa Ruhusu, kisha nenda Mipangilio → Jumla → VPN na Usimamizi wa Kifaa, gusa ChurchPresenter na usakinishe.</string>
    <string name="cert_setup_step3_ios_title">iOS — Amini cheti</string>
    <string name="cert_setup_step3_ios_body">Mipangilio → Jumla → Kuhusu → Mipangilio ya Uaminifu wa Cheti → washa uaminifu kamili kwa ChurchPresenter CA.</string>
    <string name="cert_setup_step2_android_title">Android — Sakinisha cheti</string>
    <string name="cert_setup_step2_android_body">Chrome hupakua faili ya .crt. Igusa kutoka arifa ya upakuaji, chagua “Cheti cha CA” na uipe jina kama “ChurchPresenter”.</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ “Haiwezi kusakinisha kutoka vyanzo visivyojulikana”?</string>
    <string name="cert_setup_android_unknown_sources_body">Android inaweza kuzuia usakinishaji ikiwa kivinjari chako hakiruhusiwi kusakinisha faili. Nenda Mipangilio → Programu → [kivinjari chako] → Sakinisha programu zisizojulikana, kisha washa “Ruhusu kutoka chanzo hiki”. Rudi hapa na ugusa faili tena.</string>
    <string name="cert_setup_fingerprint_title">Thibitisha alama ya kidole (inapendekezwa)</string>
    <string name="cert_setup_fingerprint_body">Linganisha alama hii na ile ChurchPresenter kwenye kompyuta inavyoonyesha kwenye Mipangilio → Seva → Certificate SHA-256. Lazima zilingane.</string>
    <string name="cert_setup_fingerprint_unavailable">Unganisha kwenye seva kwanza ili kuona alama ya kidole</string>
    <string name="cert_setup_done_button">Imekamilika — cheti kimesakinishwa</string>
    <string name="cert_setup_skip_button">Ruka kwa sasa</string>
    <string name="cert_setup_skip_note">Unaweza kurudi kwenye mwongozo huu wakati wowote kutoka Mipangilio.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Unganisha kwenye kompyuta</string>
    <string name="connect_setup_subtitle">Usanidi wa mara moja unahitajika</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile huunganisha na programu ya ChurchPresenter kwenye kompyuta katika mtandao wako wa ndani. Changanua msimbo wa QR kutoka kompyuta ili muunganisho usanidiwe kiotomatiki.</string>
    <string name="connect_setup_step1_title">Fungua ChurchPresenter kwenye kompyuta yako</string>
    <string name="connect_setup_step1_body">Zindua programu ya ChurchPresenter kwenye kompyuta na hakikisha inafanya kazi kwenye mtandao ule ule wa Wi-Fi kama kifaa hiki.</string>
    <string name="connect_setup_step2_title">Onyesha msimbo wa QR wa muunganisho</string>
    <string name="connect_setup_step2_body">Katika programu ya kompyuta nenda Mipangilio → Simu na ubonyeze “Show QR Code”. Msimbo wa QR wenye maelezo ya muunganisho utaonekana skrini.</string>
    <string name="connect_setup_step3_title">Changanua msimbo wa QR hapa chini</string>
    <string name="connect_setup_step3_body">Gusa kitufe hapa chini ili kufungua kamera na kuchanganua msimbo wa QR unaoonyeshwa kwenye kompyuta. Muunganisho utasanidiwa kiotomatiki.</string>
    <string name="connect_setup_scan_button">Changanua msimbo wa QR</string>
    <string name="connect_setup_connected">✓ Imeunganishwa na %1$s:%2$s</string>
    <string name="connect_setup_done_button">Imekamilika — imeunganishwa</string>
    <string name="connect_setup_skip_button">Ruka kwa sasa</string>
    <string name="connect_setup_skip_note">Unaweza kuchanganua msimbo wa QR wakati wowote kutoka Mipangilio.</string>

