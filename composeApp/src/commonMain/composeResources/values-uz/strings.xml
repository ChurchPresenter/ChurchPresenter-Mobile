    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Server sertifikatiga ishonish</string>
    <string name="cert_setup_subtitle">Bir martalik sozlash talab qilinadi</string>
    <string name="cert_setup_intro">ChurchPresenter xavfsiz aloqa uchun shaxsiy HTTPS sertifikatidan foydalanadi. Qurilmangiz ulanishga ishonishi uchun uni bir marta o'rnatishingiz kerak.</string>
    <string name="cert_setup_scan_title">Sertifikatning QR kodini skanerlang</string>
    <string name="cert_setup_scan_desktop_hint">Kompyuterdagi ChurchPresenter'da: Sozlamalar → Server → QR kodni ko'rsatish uchun “Download Cert” tugmasini bosing.</string>
    <string name="cert_setup_scan_button">QR kodni skanerlash</string>
    <string name="cert_setup_scan_or_divider">yoki saqlangan manzildan foydalaning</string>
    <string name="cert_setup_url_scanned">✓ URL skanerlandi</string>
    <string name="cert_setup_url_label">Sertifikat URL manzili</string>
    <string name="cert_setup_open_button">Sertifikat URL manzilini ochish</string>
    <string name="cert_setup_step2_ios_title">iOS — Profilni o'rnating</string>
    <string name="cert_setup_step2_ios_body">Safari konfiguratsiya profilini yuklab olishni so'raydi. Ruxsat berish tugmasini bosing, so'ng Sozlamalar → Umumiy → VPN va Qurilma boshqaruvi bo'limiga o'ting, ChurchPresenter'ni bosing va o'rnating.</string>
    <string name="cert_setup_step3_ios_title">iOS — Sertifikatga ishoning</string>
    <string name="cert_setup_step3_ios_body">Sozlamalar → Umumiy → Haqida → Sertifikat ishonchi sozlamalari → ChurchPresenter CA uchun to'liq ishonchni yoqing.</string>
    <string name="cert_setup_step2_android_title">Android — Sertifikatni o'rnating</string>
    <string name="cert_setup_step2_android_body">Chrome .crt faylini yuklab oladi. Yuklab olish bildirishnomasidan uni bosing, “CA sertifikati”ni tanlang va unga “ChurchPresenter” kabi nom bering.</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ “Noma'lum manbalardan o'rnatib bo'lmaydi”?</string>
    <string name="cert_setup_android_unknown_sources_body">Agar brauzeringizga fayl o'rnatishga ruxsat berilmagan bo'lsa, Android o'rnatishni bloklashi mumkin. Sozlamalar → Ilovalar → [brauzeringiz] → Noma'lum ilovalarni o'rnatish bo'limiga o'ting va “Ushbu manbaga ruxsat berish”ni yoqing. Bu yerga qayting va faylni yana bosing.</string>
    <string name="cert_setup_fingerprint_title">Barmoq izini tekshiring (tavsiya etiladi)</string>
    <string name="cert_setup_fingerprint_body">Ushbu barmoq izini kompyuterdagi ChurchPresenter Sozlamalar → Server → Certificate SHA-256 bo'limida ko'rsatadigani bilan solishtiring. Ular mos kelishi kerak.</string>
    <string name="cert_setup_fingerprint_unavailable">Barmoq izini ko'rish uchun avval serverga ulaning</string>
    <string name="cert_setup_done_button">Tayyor — sertifikat o'rnatildi</string>
    <string name="cert_setup_skip_button">Hozircha o'tkazib yuborish</string>
    <string name="cert_setup_skip_note">Ushbu qo'llanmaga istalgan vaqtda Sozlamalardan qaytishingiz mumkin.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Kompyuterga ulanish</string>
    <string name="connect_setup_subtitle">Bir martalik sozlash talab qilinadi</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile mahalliy tarmog'ingizdagi kompyuterda ishlayotgan ChurchPresenter ilovasiga ulanadi. Ulanish avtomatik sozlanishi uchun kompyuterdagi QR kodni skanerlang.</string>
    <string name="connect_setup_step1_title">Kompyuteringizda ChurchPresenter'ni oching</string>
    <string name="connect_setup_step1_body">Kompyuterda ChurchPresenter ilovasini ishga tushiring va u ushbu qurilma bilan bir xil Wi-Fi tarmog'ida ishlayotganiga ishonch hosil qiling.</string>
    <string name="connect_setup_step2_title">Ulanish QR kodini ko'rsating</string>
    <string name="connect_setup_step2_body">Kompyuter ilovasida Sozlamalar → Mobil bo'limiga o'ting va “Show QR Code” tugmasini bosing. Ekranda ulanish ma'lumotlari bilan QR kod paydo bo'ladi.</string>
    <string name="connect_setup_step3_title">Quyidagi QR kodni skanerlang</string>
    <string name="connect_setup_step3_body">Kamerani ochish va kompyuterda ko'rsatilgan QR kodni skanerlash uchun quyidagi tugmani bosing. Ulanish avtomatik sozlanadi.</string>
    <string name="connect_setup_scan_button">QR kodni skanerlash</string>
    <string name="connect_setup_connected">✓ %1$s:%2$s ga ulandi</string>
    <string name="connect_setup_done_button">Tayyor — ulandi</string>
    <string name="connect_setup_skip_button">Hozircha o'tkazib yuborish</string>
    <string name="connect_setup_skip_note">QR kodni istalgan vaqtda Sozlamalardan skanerlashingiz mumkin.</string>

