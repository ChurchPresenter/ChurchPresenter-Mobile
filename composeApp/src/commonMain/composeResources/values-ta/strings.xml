    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">சேவையகச் சான்றிதழை நம்புங்கள்</string>
    <string name="cert_setup_subtitle">ஒருமுறை அமைவு தேவை</string>
    <string name="cert_setup_intro">ChurchPresenter பாதுகாப்பான தொடர்புக்காக தனியார் HTTPS சான்றிதழைப் பயன்படுத்துகிறது. உங்கள் சாதனம் இந்த இணைப்பை நம்புவதற்கு அதை ஒருமுறை நிறுவ வேண்டும்.</string>
    <string name="cert_setup_scan_title">சான்றிதழின் QR குறியீட்டை ஸ்கேன் செய்யவும்</string>
    <string name="cert_setup_scan_desktop_hint">கணினியில் உள்ள ChurchPresenter-இல்: அமைப்புகள் → சேவையகம் → QR குறியீட்டைக் காட்ட “Download Cert” அழுத்தவும்.</string>
    <string name="cert_setup_scan_button">QR குறியீட்டை ஸ்கேன் செய்</string>
    <string name="cert_setup_scan_or_divider">அல்லது சேமித்த முகவரியைப் பயன்படுத்தவும்</string>
    <string name="cert_setup_url_scanned">✓ URL ஸ்கேன் செய்யப்பட்டது</string>
    <string name="cert_setup_url_label">சான்றிதழ் URL</string>
    <string name="cert_setup_open_button">சான்றிதழ் URL-ஐத் திற</string>
    <string name="cert_setup_step2_ios_title">iOS — சுயவிவரத்தை நிறுவவும்</string>
    <string name="cert_setup_step2_ios_body">Safari ஒரு கட்டமைப்பு சுயவிவரத்தைப் பதிவிறக்கக் கேட்கும். அனுமதி என்பதைத் தட்டவும், பின்னர் அமைப்புகள் → பொது → VPN மற்றும் சாதன மேலாண்மை என்பதற்குச் சென்று ChurchPresenter-ஐத் தட்டி நிறுவவும்.</string>
    <string name="cert_setup_step3_ios_title">iOS — சான்றிதழை நம்பவும்</string>
    <string name="cert_setup_step3_ios_body">அமைப்புகள் → பொது → பற்றி → சான்றிதழ் நம்பிக்கை அமைப்புகள் → ChurchPresenter CA-க்கு முழு நம்பிக்கையை இயக்கவும்.</string>
    <string name="cert_setup_step2_android_title">Android — சான்றிதழை நிறுவவும்</string>
    <string name="cert_setup_step2_android_body">Chrome .crt கோப்பைப் பதிவிறக்கும். பதிவிறக்க அறிவிப்பிலிருந்து அதைத் தட்டி, “CA சான்றிதழ்” என்பதைத் தேர்ந்தெடுத்து, “ChurchPresenter” போன்ற பெயரைக் கொடுக்கவும்.</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ “அறியப்படாத மூலங்களிலிருந்து நிறுவ முடியாது”?</string>
    <string name="cert_setup_android_unknown_sources_body">உங்கள் உலாவிக்கு கோப்புகளை நிறுவ அனுமதி இல்லையெனில் Android நிறுவலைத் தடுக்கலாம். அமைப்புகள் → பயன்பாடுகள் → [உங்கள் உலாவி] → அறியப்படாத பயன்பாடுகளை நிறுவு என்பதற்குச் சென்று “இந்த மூலத்திலிருந்து அனுமதி” இயக்கவும். இங்கே திரும்பி கோப்பை மீண்டும் தட்டவும்.</string>
    <string name="cert_setup_fingerprint_title">கைரேகையைச் சரிபார்க்கவும் (பரிந்துரைக்கப்படுகிறது)</string>
    <string name="cert_setup_fingerprint_body">இந்தக் கைரேகையை கணினியில் உள்ள ChurchPresenter அமைப்புகள் → சேவையகம் → Certificate SHA-256 இல் காட்டுவதுடன் ஒப்பிடவும். இரண்டும் பொருந்த வேண்டும்.</string>
    <string name="cert_setup_fingerprint_unavailable">கைரேகையைக் காண முதலில் சேவையகத்துடன் இணைக்கவும்</string>
    <string name="cert_setup_done_button">முடிந்தது — சான்றிதழ் நிறுவப்பட்டது</string>
    <string name="cert_setup_skip_button">இப்போதைக்கு தவிர்</string>
    <string name="cert_setup_skip_note">இந்த வழிகாட்டிக்கு அமைப்புகளிலிருந்து எப்போது வேண்டுமானாலும் திரும்பலாம்.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">கணினியுடன் இணைக்கவும்</string>
    <string name="connect_setup_subtitle">ஒருமுறை அமைவு தேவை</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile உங்கள் உள்ளூர் வலையமைப்பில் உள்ள கணினியில் இயங்கும் ChurchPresenter செயலியுடன் இணைகிறது. இணைப்பு தானாக அமைய கணினியில் உள்ள QR குறியீட்டை ஸ்கேன் செய்யவும்.</string>
    <string name="connect_setup_step1_title">உங்கள் கணினியில் ChurchPresenter-ஐத் திறக்கவும்</string>
    <string name="connect_setup_step1_body">கணினியில் ChurchPresenter டெஸ்க்டாப் செயலியைத் தொடங்கி, இந்தச் சாதனத்தின் அதே Wi-Fi வலையமைப்பில் இயங்குகிறதா என உறுதி செய்யவும்.</string>
    <string name="connect_setup_step2_title">இணைப்பு QR குறியீட்டைக் காட்டவும்</string>
    <string name="connect_setup_step2_body">டெஸ்க்டாப் செயலியில் அமைப்புகள் → மொபைல் என்பதற்குச் சென்று “Show QR Code” அழுத்தவும். இணைப்பு விவரங்களுடன் QR குறியீடு திரையில் தோன்றும்.</string>
    <string name="connect_setup_step3_title">கீழே உள்ள QR குறியீட்டை ஸ்கேன் செய்யவும்</string>
    <string name="connect_setup_step3_body">கேமராவைத் திறந்து கணினியில் காட்டப்படும் QR குறியீட்டை ஸ்கேன் செய்ய கீழே உள்ள பொத்தானைத் தட்டவும். இணைப்பு தானாக அமைக்கப்படும்.</string>
    <string name="connect_setup_scan_button">QR குறியீட்டை ஸ்கேன் செய்</string>
    <string name="connect_setup_connected">✓ %1$s:%2$s உடன் இணைக்கப்பட்டது</string>
    <string name="connect_setup_done_button">முடிந்தது — இணைக்கப்பட்டது</string>
    <string name="connect_setup_skip_button">இப்போதைக்கு தவிர்</string>
    <string name="connect_setup_skip_note">QR குறியீட்டை அமைப்புகளிலிருந்து எப்போது வேண்டுமானாலும் ஸ்கேன் செய்யலாம்.</string>

