    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Aprobă certificatul serverului</string>
    <string name="cert_setup_subtitle">Configurare unică necesară</string>
    <string name="cert_setup_intro">ChurchPresenter folosește un certificat HTTPS privat pentru comunicare securizată. Trebuie să îl instalezi o singură dată pentru ca dispozitivul tău să aibă încredere în conexiune.</string>
    <string name="cert_setup_scan_title">Scanează codul QR al certificatului</string>
    <string name="cert_setup_scan_desktop_hint">Pe ChurchPresenter desktop: Setări → Server → apasă „Download Cert” pentru a afișa codul QR.</string>
    <string name="cert_setup_scan_button">Scanează codul QR</string>
    <string name="cert_setup_scan_or_divider">sau folosește adresa salvată</string>
    <string name="cert_setup_url_scanned">✓ URL scanat</string>
    <string name="cert_setup_url_label">URL certificat</string>
    <string name="cert_setup_open_button">Deschide URL-ul certificatului</string>
    <string name="cert_setup_step2_ios_title">iOS — Instalează profilul</string>
    <string name="cert_setup_step2_ios_body">Safari va cere descărcarea unui profil de configurare. Apasă Permite, apoi mergi la Setări → General → VPN &amp; Device Management, apasă ChurchPresenter și instalează.</string>
    <string name="cert_setup_step3_ios_title">iOS — Aprobă certificatul</string>
    <string name="cert_setup_step3_ios_body">Setări → General → Despre → Setări de încredere a certificatelor → activează încrederea completă pentru ChurchPresenter CA.</string>
    <string name="cert_setup_step2_android_title">Android — Instalează certificatul</string>
    <string name="cert_setup_step2_android_body">Chrome descarcă fișierul .crt. Apasă-l din notificarea de descărcări, alege „CA Certificate” și dă-i un nume precum „ChurchPresenter”.</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ „Nu se poate instala din surse necunoscute”?</string>
    <string name="cert_setup_android_unknown_sources_body">Android poate bloca instalarea dacă browserul tău nu are voie să instaleze fișiere. Mergi la Setări → Aplicații → [browserul tău] → Instalare aplicații necunoscute, apoi activează „Permite din această sursă”. Revino aici și apasă din nou pe fișier.</string>
    <string name="cert_setup_fingerprint_title">Verifică amprenta (recomandat)</string>
    <string name="cert_setup_fingerprint_body">Compară această amprentă cu ceea ce afișează ChurchPresenter desktop în Setări → Server → Certificate SHA-256. Trebuie să coincidă.</string>
    <string name="cert_setup_fingerprint_unavailable">Conectează-te mai întâi la server pentru a vedea amprenta</string>
    <string name="cert_setup_done_button">Gata — Certificat instalat</string>
    <string name="cert_setup_skip_button">Omite deocamdată</string>
    <string name="cert_setup_skip_note">Poți reveni la acest ghid oricând din Setări.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Conectare la desktop</string>
    <string name="connect_setup_subtitle">Configurare unică necesară</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile se conectează la aplicația desktop ChurchPresenter din rețeaua ta locală. Scanează codul QR de pe desktop pentru a configura automat conexiunea.</string>
    <string name="connect_setup_skip_button">Omite deocamdată</string>
    <string name="connect_setup_done_button">Gata — Conectat</string>
    <string name="connect_setup_skip_note">Poți scana codul QR oricând din Setări.</string>
    <string name="connect_setup_step1_title">Deschide ChurchPresenter pe computerul tău</string>
    <string name="connect_setup_step1_body">Lansează aplicația desktop ChurchPresenter și asigură-te că rulează în aceeași rețea Wi-Fi ca acest dispozitiv.</string>
    <string name="connect_setup_step2_title">Afișează codul QR de conexiune</string>
    <string name="connect_setup_step2_body">În aplicația desktop mergi la Setări → Mobile → și apasă „Show QR Code”. Un cod QR cu detaliile conexiunii va apărea pe ecran.</string>
    <string name="connect_setup_step3_title">Scanează codul QR de mai jos</string>
    <string name="connect_setup_step3_body">Apasă butonul de mai jos pentru a deschide camera și a scana codul QR afișat pe desktop. Conexiunea va fi configurată automat.</string>
    <string name="connect_setup_scan_button">Scanează codul QR</string>
    <string name="connect_setup_connected">✓ Conectat la %1$s:%2$s</string>
    <string name="connect_setup_no_camera_note">Nicio cameră detectată pe acest dispozitiv. Introdu detaliile conexiunii manual:</string>
