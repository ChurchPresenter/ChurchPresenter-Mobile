    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Sunucu sertifikasına güven</string>
    <string name="cert_setup_subtitle">Tek seferlik kurulum gerekiyor</string>
    <string name="cert_setup_intro">ChurchPresenter güvenli iletişim için özel bir HTTPS sertifikası kullanır. Cihazınızın bağlantıya güvenmesi için bunu bir kez kurmanız gerekir.</string>
    <string name="cert_setup_scan_title">Sertifikanın QR kodunu tarayın</string>
    <string name="cert_setup_scan_desktop_hint">Bilgisayardaki ChurchPresenter'da: Ayarlar → Sunucu → QR kodu göstermek için “Download Cert” düğmesine basın.</string>
    <string name="cert_setup_scan_button">QR kodu tara</string>
    <string name="cert_setup_scan_or_divider">veya kayıtlı adresi kullan</string>
    <string name="cert_setup_url_scanned">✓ URL tarandı</string>
    <string name="cert_setup_url_label">Sertifika URL'si</string>
    <string name="cert_setup_open_button">Sertifika URL'sini aç</string>
    <string name="cert_setup_step2_ios_title">iOS — Profili yükleyin</string>
    <string name="cert_setup_step2_ios_body">Safari bir yapılandırma profili indirmek isteyecek. İzin Ver'e dokunun, ardından Ayarlar → Genel → VPN ve Cihaz Yönetimi'ne gidin, ChurchPresenter'a dokunun ve yükleyin.</string>
    <string name="cert_setup_step3_ios_title">iOS — Sertifikaya güvenin</string>
    <string name="cert_setup_step3_ios_body">Ayarlar → Genel → Hakkında → Sertifika Güven Ayarları → ChurchPresenter CA için tam güveni açın.</string>
    <string name="cert_setup_step2_android_title">Android — Sertifikayı yükleyin</string>
    <string name="cert_setup_step2_android_body">Chrome .crt dosyasını indirir. İndirme bildiriminden dosyaya dokunun, “CA Sertifikası”nı seçin ve “ChurchPresenter” gibi bir ad verin.</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ “Bilinmeyen kaynaklardan yüklenemiyor” mu?</string>
    <string name="cert_setup_android_unknown_sources_body">Tarayıcınızın dosya yüklemesine izin verilmiyorsa Android kurulumu engelleyebilir. Ayarlar → Uygulamalar → [tarayıcınız] → Bilinmeyen uygulamaları yükle bölümüne gidin ve “Bu kaynağa izin ver”i açın. Buraya dönün ve dosyaya tekrar dokunun.</string>
    <string name="cert_setup_fingerprint_title">Parmak izini doğrulayın (önerilir)</string>
    <string name="cert_setup_fingerprint_body">Bu parmak izini bilgisayardaki ChurchPresenter'ın Ayarlar → Sunucu → Certificate SHA-256 bölümünde gösterdiğiyle karşılaştırın. Eşleşmelidirler.</string>
    <string name="cert_setup_fingerprint_unavailable">Parmak izini görmek için önce sunucuya bağlanın</string>
    <string name="cert_setup_done_button">Tamam — sertifika yüklendi</string>
    <string name="cert_setup_skip_button">Şimdilik atla</string>
    <string name="cert_setup_skip_note">Bu kılavuza istediğiniz zaman Ayarlar'dan dönebilirsiniz.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Bilgisayara bağlan</string>
    <string name="connect_setup_subtitle">Tek seferlik kurulum gerekiyor</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile, yerel ağınızdaki bilgisayarda çalışan ChurchPresenter uygulamasına bağlanır. Bağlantıyı otomatik yapılandırmak için bilgisayardaki QR kodu tarayın.</string>
    <string name="connect_setup_step1_title">Bilgisayarınızda ChurchPresenter'ı açın</string>
    <string name="connect_setup_step1_body">ChurchPresenter masaüstü uygulamasını başlatın ve bu cihazla aynı Wi-Fi ağında çalıştığından emin olun.</string>
    <string name="connect_setup_step2_title">Bağlantı QR kodunu gösterin</string>
    <string name="connect_setup_step2_body">Masaüstü uygulamasında Ayarlar → Mobil bölümüne gidin ve “Show QR Code”a basın. Bağlantı bilgilerini içeren bir QR kod ekranda görünecek.</string>
    <string name="connect_setup_step3_title">Aşağıdaki QR kodu tarayın</string>
    <string name="connect_setup_step3_body">Kamerayı açmak ve bilgisayarda gösterilen QR kodu taramak için aşağıdaki düğmeye dokunun. Bağlantı otomatik olarak yapılandırılacak.</string>
    <string name="connect_setup_scan_button">QR kodu tara</string>
    <string name="connect_setup_connected">✓ %1$s:%2$s adresine bağlanıldı</string>
    <string name="connect_setup_done_button">Tamam — bağlanıldı</string>
    <string name="connect_setup_skip_button">Şimdilik atla</string>
    <string name="connect_setup_skip_note">QR kodu istediğiniz zaman Ayarlar'dan tarayabilirsiniz.</string>

