    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">सर्वर प्रमाणपत्र पर भरोसा करें</string>
    <string name="cert_setup_subtitle">एक बार की सेटअप आवश्यक है</string>
    <string name="cert_setup_intro">ChurchPresenter सुरक्षित संचार के लिए निजी HTTPS प्रमाणपत्र का उपयोग करता है। आपको इसे एक बार इंस्टॉल करना होगा ताकि आपका डिवाइस इस कनेक्शन पर भरोसा करे।</string>
    <string name="cert_setup_scan_title">प्रमाणपत्र का QR कोड स्कैन करें</string>
    <string name="cert_setup_scan_desktop_hint">कंप्यूटर के ChurchPresenter में: सेटिंग → सर्वर → QR कोड दिखाने के लिए “Download Cert” दबाएँ।</string>
    <string name="cert_setup_scan_button">QR कोड स्कैन करें</string>
    <string name="cert_setup_scan_or_divider">या सहेजा गया पता उपयोग करें</string>
    <string name="cert_setup_url_scanned">✓ URL स्कैन किया गया</string>
    <string name="cert_setup_url_label">प्रमाणपत्र URL</string>
    <string name="cert_setup_open_button">प्रमाणपत्र URL खोलें</string>
    <string name="cert_setup_step2_ios_title">iOS — प्रोफ़ाइल इंस्टॉल करें</string>
    <string name="cert_setup_step2_ios_body">Safari कॉन्फ़िगरेशन प्रोफ़ाइल डाउनलोड करने को कहेगा। अनुमति दें पर टैप करें, फिर सेटिंग → सामान्य → VPN और डिवाइस प्रबंधन पर जाएँ, ChurchPresenter पर टैप करें और इंस्टॉल करें।</string>
    <string name="cert_setup_step3_ios_title">iOS — प्रमाणपत्र पर भरोसा करें</string>
    <string name="cert_setup_step3_ios_body">सेटिंग → सामान्य → परिचय → प्रमाणपत्र विश्वास सेटिंग → ChurchPresenter CA के लिए पूर्ण विश्वास सक्षम करें।</string>
    <string name="cert_setup_step2_android_title">Android — प्रमाणपत्र इंस्टॉल करें</string>
    <string name="cert_setup_step2_android_body">Chrome .crt फ़ाइल डाउनलोड करता है। डाउनलोड सूचना से उस पर टैप करें, “CA प्रमाणपत्र” चुनें और उसे “ChurchPresenter” जैसा नाम दें।</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ “अज्ञात स्रोतों से इंस्टॉल नहीं हो सकता”?</string>
    <string name="cert_setup_android_unknown_sources_body">यदि आपके ब्राउज़र को फ़ाइल इंस्टॉल करने की अनुमति नहीं है तो Android इंस्टॉल रोक सकता है। सेटिंग → ऐप्स → [आपका ब्राउज़र] → अज्ञात ऐप्स इंस्टॉल करें पर जाएँ, फिर “इस स्रोत से अनुमति दें” सक्षम करें। यहाँ लौटें और फ़ाइल पर फिर टैप करें।</string>
    <string name="cert_setup_fingerprint_title">फ़िंगरप्रिंट सत्यापित करें (अनुशंसित)</string>
    <string name="cert_setup_fingerprint_body">इस फ़िंगरप्रिंट की तुलना उससे करें जो कंप्यूटर पर ChurchPresenter सेटिंग → सर्वर → Certificate SHA-256 में दिखाता है। दोनों मेल खाने चाहिए।</string>
    <string name="cert_setup_fingerprint_unavailable">फ़िंगरप्रिंट देखने के लिए पहले सर्वर से कनेक्ट करें</string>
    <string name="cert_setup_done_button">पूर्ण — प्रमाणपत्र इंस्टॉल हो गया</string>
    <string name="cert_setup_skip_button">अभी छोड़ें</string>
    <string name="cert_setup_skip_note">आप इस मार्गदर्शिका पर सेटिंग से कभी भी लौट सकते हैं।</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">कंप्यूटर से कनेक्ट करें</string>
    <string name="connect_setup_subtitle">एक बार की सेटअप आवश्यक है</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile आपके स्थानीय नेटवर्क में कंप्यूटर पर चल रहे ChurchPresenter ऐप से जुड़ता है। कनेक्शन अपने आप कॉन्फ़िगर करने के लिए कंप्यूटर से QR कोड स्कैन करें।</string>
    <string name="connect_setup_step1_title">अपने कंप्यूटर पर ChurchPresenter खोलें</string>
    <string name="connect_setup_step1_body">कंप्यूटर पर ChurchPresenter डेस्कटॉप ऐप चलाएँ और सुनिश्चित करें कि यह इस डिवाइस के समान Wi-Fi नेटवर्क पर है।</string>
    <string name="connect_setup_step2_title">कनेक्शन QR कोड दिखाएँ</string>
    <string name="connect_setup_step2_body">डेस्कटॉप ऐप में सेटिंग → मोबाइल पर जाएँ और “Show QR Code” दबाएँ। कनेक्शन विवरण वाला QR कोड स्क्रीन पर दिखेगा।</string>
    <string name="connect_setup_step3_title">नीचे दिया QR कोड स्कैन करें</string>
    <string name="connect_setup_step3_body">कैमरा खोलने और कंप्यूटर पर दिख रहा QR कोड स्कैन करने के लिए नीचे बटन पर टैप करें। कनेक्शन अपने आप कॉन्फ़िगर हो जाएगा।</string>
    <string name="connect_setup_scan_button">QR कोड स्कैन करें</string>
    <string name="connect_setup_connected">✓ %1$s:%2$s से जुड़ा</string>
