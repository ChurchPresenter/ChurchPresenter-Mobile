    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Uzticēties servera sertifikātam</string>
    <string name="cert_setup_subtitle">Nepieciešama vienreizēja iestatīšana</string>
    <string name="cert_setup_intro">ChurchPresenter izmanto privātu HTTPS sertifikātu drošai saziņai. Tas vienreiz jāinstalē, lai ierīce uzticētos savienojumam.</string>
    <string name="cert_setup_scan_title">Skenējiet sertifikāta QR kodu</string>
    <string name="cert_setup_scan_desktop_hint">ChurchPresenter datorā: Iestatījumi → Serveris → nospiediet “Download Cert”, lai parādītu QR kodu.</string>
    <string name="cert_setup_scan_button">Skenēt QR kodu</string>
    <string name="cert_setup_scan_or_divider">vai izmantot saglabāto adresi</string>
    <string name="cert_setup_url_scanned">✓ URL noskenēts</string>
    <string name="cert_setup_url_label">Sertifikāta URL</string>
    <string name="cert_setup_open_button">Atvērt sertifikāta URL</string>
    <string name="cert_setup_step2_ios_title">iOS — Instalējiet profilu</string>
    <string name="cert_setup_step2_ios_body">Safari lūgs lejupielādēt konfigurācijas profilu. Pieskarieties Atļaut, pēc tam dodieties uz Iestatījumi → Vispārīgi → VPN un ierīču pārvaldība, pieskarieties ChurchPresenter un instalējiet.</string>
    <string name="cert_setup_step3_ios_title">iOS — Uzticieties sertifikātam</string>
    <string name="cert_setup_step3_ios_body">Iestatījumi → Vispārīgi → Par → Sertifikātu uzticamības iestatījumi → ieslēdziet pilnu uzticēšanos ChurchPresenter CA.</string>
    <string name="cert_setup_step2_android_title">Android — Instalējiet sertifikātu</string>
    <string name="cert_setup_step2_android_body">Chrome lejupielādē .crt failu. Pieskarieties tam lejupielāžu paziņojumā, izvēlieties “CA sertifikāts” un piešķiriet nosaukumu, piemēram, “ChurchPresenter”.</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ “Nevar instalēt no nezināmiem avotiem”?</string>
    <string name="cert_setup_android_unknown_sources_body">Android var bloķēt instalēšanu, ja pārlūkam nav atļauts instalēt failus. Dodieties uz Iestatījumi → Lietotnes → [jūsu pārlūks] → Instalēt nezināmas lietotnes un ieslēdziet “Atļaut no šī avota”. Atgriezieties šeit un pieskarieties failam vēlreiz.</string>
    <string name="cert_setup_fingerprint_title">Pārbaudiet nospiedumu (ieteicams)</string>
    <string name="cert_setup_fingerprint_body">Salīdziniet šo nospiedumu ar to, ko ChurchPresenter datorā rāda sadaļā Iestatījumi → Serveris → Certificate SHA-256. Tiem jāsakrīt.</string>
    <string name="cert_setup_fingerprint_unavailable">Vispirms izveidojiet savienojumu ar serveri, lai redzētu nospiedumu</string>
    <string name="cert_setup_done_button">Gatavs — sertifikāts instalēts</string>
    <string name="cert_setup_skip_button">Izlaist pagaidām</string>
    <string name="cert_setup_skip_note">Jūs jebkurā laikā varat atgriezties pie šīs pamācības no Iestatījumiem.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Savienoties ar datoru</string>
    <string name="connect_setup_subtitle">Nepieciešama vienreizēja iestatīšana</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile savienojas ar ChurchPresenter lietotni datorā vietējā tīklā. Noskenējiet QR kodu no datora, lai savienojumu konfigurētu automātiski.</string>
    <string name="connect_setup_step1_title">Atveriet ChurchPresenter datorā</string>
    <string name="connect_setup_step1_body">Palaidiet ChurchPresenter lietotni datorā un pārliecinieties, ka tā darbojas tajā pašā Wi-Fi tīklā, kur šī ierīce.</string>
    <string name="connect_setup_step2_title">Parādiet savienojuma QR kodu</string>
    <string name="connect_setup_step2_body">Datora lietotnē dodieties uz Iestatījumi → Mobilais un nospiediet “Show QR Code”. Ekrānā parādīsies QR kods ar savienojuma datiem.</string>
    <string name="connect_setup_step3_title">Noskenējiet zemāk esošo QR kodu</string>
    <string name="connect_setup_step3_body">Pieskarieties pogai zemāk, lai atvērtu kameru un noskenētu datorā redzamo QR kodu. Savienojums tiks konfigurēts automātiski.</string>
    <string name="connect_setup_scan_button">Skenēt QR kodu</string>
    <string name="connect_setup_connected">✓ Savienots ar %1$s:%2$s</string>
    <string name="connect_setup_done_button">Gatavs — savienots</string>
    <string name="connect_setup_skip_button">Izlaist pagaidām</string>
    <string name="connect_setup_skip_note">Jūs jebkurā laikā varat noskenēt QR kodu no Iestatījumiem.</string>

