    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">信任服务器证书</string>
    <string name="cert_setup_subtitle">需要一次性设置</string>
    <string name="cert_setup_intro">ChurchPresenter 使用私有 HTTPS 证书来保证通信安全。您需要安装一次，设备才会信任此连接。</string>
    <string name="cert_setup_scan_title">扫描证书二维码</string>
    <string name="cert_setup_scan_desktop_hint">在电脑的 ChurchPresenter 中：设置 → 服务器 → 按“Download Cert”显示二维码。</string>
    <string name="cert_setup_scan_button">扫描二维码</string>
    <string name="cert_setup_scan_or_divider">或使用已保存的地址</string>
    <string name="cert_setup_url_scanned">✓ 已扫描 URL</string>
    <string name="cert_setup_url_label">证书 URL</string>
    <string name="cert_setup_open_button">打开证书 URL</string>
    <string name="cert_setup_step2_ios_title">iOS — 安装描述文件</string>
    <string name="cert_setup_step2_ios_body">Safari 会提示下载配置描述文件。点按“允许”，然后前往 设置 → 通用 → VPN 与设备管理，点按 ChurchPresenter 并安装。</string>
    <string name="cert_setup_step3_ios_title">iOS — 信任该证书</string>
    <string name="cert_setup_step3_ios_body">设置 → 通用 → 关于本机 → 证书信任设置 → 为 ChurchPresenter CA 启用完全信任。</string>
    <string name="cert_setup_step2_android_title">Android — 安装证书</string>
    <string name="cert_setup_step2_android_body">Chrome 会下载 .crt 文件。从下载通知中点按该文件，选择“CA 证书”，并命名为“ChurchPresenter”之类的名称。</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ 提示“无法从未知来源安装”？</string>
    <string name="cert_setup_android_unknown_sources_body">如果浏览器未获准安装文件，Android 可能会阻止安装。前往 设置 → 应用 →［您的浏览器］→ 安装未知应用，然后启用“允许来自此来源”。返回此处并再次点按该文件。</string>
    <string name="cert_setup_fingerprint_title">核对指纹（推荐）</string>
    <string name="cert_setup_fingerprint_body">请将此指纹与电脑上 ChurchPresenter 的 设置 → 服务器 → Certificate SHA-256 中显示的指纹进行比对，两者必须一致。</string>
    <string name="cert_setup_fingerprint_unavailable">请先连接服务器以查看指纹</string>
    <string name="cert_setup_done_button">完成 — 证书已安装</string>
    <string name="cert_setup_skip_button">暂时跳过</string>
    <string name="cert_setup_skip_note">您随时可以从设置返回此指南。</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">连接到电脑</string>
    <string name="connect_setup_subtitle">需要一次性设置</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile 会连接到本地网络中电脑上的 ChurchPresenter 应用。扫描电脑上的二维码即可自动配置连接。</string>
    <string name="connect_setup_step1_title">在电脑上打开 ChurchPresenter</string>
    <string name="connect_setup_step1_body">启动电脑上的 ChurchPresenter 桌面应用，并确保它与本设备处于同一 Wi-Fi 网络。</string>
    <string name="connect_setup_step2_title">显示连接二维码</string>
    <string name="connect_setup_step2_body">在桌面应用中前往 设置 → 移动设备，按“Show QR Code”。屏幕上会出现包含连接信息的二维码。</string>
    <string name="connect_setup_step3_title">扫描下方二维码</string>
    <string name="connect_setup_step3_body">点按下方按钮打开相机，扫描电脑上显示的二维码。连接将自动完成配置。</string>
    <string name="connect_setup_scan_button">扫描二维码</string>
