    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">เชื่อถือใบรับรองของเซิร์ฟเวอร์</string>
    <string name="cert_setup_subtitle">ต้องตั้งค่าเพียงครั้งเดียว</string>
    <string name="cert_setup_intro">ChurchPresenter ใช้ใบรับรอง HTTPS ส่วนตัวเพื่อการสื่อสารที่ปลอดภัย คุณต้องติดตั้งหนึ่งครั้งเพื่อให้อุปกรณ์เชื่อถือการเชื่อมต่อนี้</string>
    <string name="cert_setup_scan_title">สแกนคิวอาร์โค้ดของใบรับรอง</string>
    <string name="cert_setup_scan_desktop_hint">ใน ChurchPresenter บนคอมพิวเตอร์: การตั้งค่า → เซิร์ฟเวอร์ → กด “Download Cert” เพื่อแสดงคิวอาร์โค้ด</string>
    <string name="cert_setup_scan_button">สแกนคิวอาร์โค้ด</string>
    <string name="cert_setup_scan_or_divider">หรือใช้ที่อยู่ที่บันทึกไว้</string>
    <string name="cert_setup_url_scanned">✓ สแกน URL แล้ว</string>
    <string name="cert_setup_url_label">URL ของใบรับรอง</string>
    <string name="cert_setup_open_button">เปิด URL ของใบรับรอง</string>
    <string name="cert_setup_step2_ios_title">iOS — ติดตั้งโปรไฟล์</string>
    <string name="cert_setup_step2_ios_body">Safari จะขอดาวน์โหลดโปรไฟล์การกำหนดค่า แตะ อนุญาต แล้วไปที่ การตั้งค่า → ทั่วไป → VPN และการจัดการอุปกรณ์ แตะ ChurchPresenter และติดตั้ง</string>
    <string name="cert_setup_step3_ios_title">iOS — เชื่อถือใบรับรอง</string>
    <string name="cert_setup_step3_ios_body">การตั้งค่า → ทั่วไป → เกี่ยวกับ → การตั้งค่าความเชื่อถือใบรับรอง → เปิดความเชื่อถือเต็มรูปแบบสำหรับ ChurchPresenter CA</string>
    <string name="cert_setup_step2_android_title">Android — ติดตั้งใบรับรอง</string>
    <string name="cert_setup_step2_android_body">Chrome จะดาวน์โหลดไฟล์ .crt แตะไฟล์จากการแจ้งเตือนดาวน์โหลด เลือก “ใบรับรอง CA” และตั้งชื่อเช่น “ChurchPresenter”</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ ขึ้นว่า “ติดตั้งจากแหล่งที่ไม่รู้จักไม่ได้” ใช่ไหม</string>
    <string name="cert_setup_android_unknown_sources_body">Android อาจบล็อกการติดตั้งหากเบราว์เซอร์ของคุณไม่ได้รับอนุญาตให้ติดตั้งไฟล์ ไปที่ การตั้งค่า → แอป → [เบราว์เซอร์ของคุณ] → ติดตั้งแอปที่ไม่รู้จัก แล้วเปิด “อนุญาตจากแหล่งนี้” กลับมาที่นี่และแตะไฟล์อีกครั้ง</string>
    <string name="cert_setup_fingerprint_title">ตรวจสอบลายนิ้วมือ (แนะนำ)</string>
    <string name="cert_setup_fingerprint_body">เปรียบเทียบลายนิ้วมือนี้กับที่ ChurchPresenter บนคอมพิวเตอร์แสดงใน การตั้งค่า → เซิร์ฟเวอร์ → Certificate SHA-256 ทั้งสองต้องตรงกัน</string>
    <string name="cert_setup_fingerprint_unavailable">เชื่อมต่อเซิร์ฟเวอร์ก่อนเพื่อดูลายนิ้วมือ</string>
    <string name="cert_setup_done_button">เสร็จสิ้น — ติดตั้งใบรับรองแล้ว</string>
    <string name="cert_setup_skip_button">ข้ามไปก่อน</string>
    <string name="cert_setup_skip_note">คุณกลับมาที่คู่มือนี้ได้ทุกเมื่อจากการตั้งค่า</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">เชื่อมต่อกับคอมพิวเตอร์</string>
    <string name="connect_setup_subtitle">ต้องตั้งค่าเพียงครั้งเดียว</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile เชื่อมต่อกับแอป ChurchPresenter บนคอมพิวเตอร์ในเครือข่ายท้องถิ่นของคุณ สแกนคิวอาร์โค้ดจากคอมพิวเตอร์เพื่อกำหนดค่าการเชื่อมต่ออัตโนมัติ</string>
    <string name="connect_setup_step1_title">เปิด ChurchPresenter บนคอมพิวเตอร์</string>
    <string name="connect_setup_step1_body">เปิดแอป ChurchPresenter บนคอมพิวเตอร์ และตรวจสอบว่าอยู่บนเครือข่าย Wi-Fi เดียวกับอุปกรณ์นี้</string>
    <string name="connect_setup_step2_title">แสดงคิวอาร์โค้ดสำหรับเชื่อมต่อ</string>
    <string name="connect_setup_step2_body">ในแอปบนคอมพิวเตอร์ไปที่ การตั้งค่า → มือถือ แล้วกด “Show QR Code” คิวอาร์โค้ดพร้อมรายละเอียดการเชื่อมต่อจะปรากฏบนหน้าจอ</string>
    <string name="connect_setup_step3_title">สแกนคิวอาร์โค้ดด้านล่าง</string>
    <string name="connect_setup_step3_body">แตะปุ่มด้านล่างเพื่อเปิดกล้องและสแกนคิวอาร์โค้ดที่แสดงบนคอมพิวเตอร์ การเชื่อมต่อจะถูกกำหนดค่าอัตโนมัติ</string>
