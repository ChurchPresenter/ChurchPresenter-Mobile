    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Percayai sertifikat server</string>
    <string name="cert_setup_subtitle">Perlu penyiapan sekali saja</string>
    <string name="cert_setup_intro">ChurchPresenter menggunakan sertifikat HTTPS pribadi untuk komunikasi yang aman. Anda perlu memasangnya sekali agar perangkat Anda memercayai koneksi ini.</string>
    <string name="cert_setup_scan_title">Pindai kode QR sertifikat</string>
    <string name="cert_setup_scan_desktop_hint">Di ChurchPresenter pada komputer: Pengaturan → Server → tekan “Download Cert” untuk menampilkan kode QR.</string>
    <string name="cert_setup_scan_button">Pindai kode QR</string>
    <string name="cert_setup_scan_or_divider">atau gunakan alamat tersimpan</string>
    <string name="cert_setup_url_scanned">✓ URL terpindai</string>
    <string name="cert_setup_url_label">URL sertifikat</string>
    <string name="cert_setup_open_button">Buka URL sertifikat</string>
    <string name="cert_setup_step2_ios_title">iOS — Pasang profil</string>
    <string name="cert_setup_step2_ios_body">Safari akan meminta mengunduh profil konfigurasi. Ketuk Izinkan, lalu buka Pengaturan → Umum → VPN &amp; Manajemen Perangkat, ketuk ChurchPresenter dan pasang.</string>
    <string name="cert_setup_step3_ios_title">iOS — Percayai sertifikat</string>
    <string name="cert_setup_step3_ios_body">Pengaturan → Umum → Tentang → Pengaturan Kepercayaan Sertifikat → aktifkan kepercayaan penuh untuk ChurchPresenter CA.</string>
    <string name="cert_setup_step2_android_title">Android — Pasang sertifikat</string>
    <string name="cert_setup_step2_android_body">Chrome mengunduh berkas .crt. Ketuk berkas itu dari notifikasi unduhan, pilih “Sertifikat CA” dan beri nama seperti “ChurchPresenter”.</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ “Tidak dapat memasang dari sumber tidak dikenal”?</string>
    <string name="cert_setup_android_unknown_sources_body">Android dapat memblokir pemasangan jika peramban Anda tidak diizinkan memasang berkas. Buka Pengaturan → Aplikasi → [peramban Anda] → Pasang aplikasi tidak dikenal, lalu aktifkan “Izinkan dari sumber ini”. Kembali ke sini dan ketuk berkas lagi.</string>
    <string name="cert_setup_fingerprint_title">Verifikasi sidik jari (disarankan)</string>
    <string name="cert_setup_fingerprint_body">Bandingkan sidik jari ini dengan yang ditampilkan ChurchPresenter di komputer pada Pengaturan → Server → Certificate SHA-256. Keduanya harus cocok.</string>
    <string name="cert_setup_fingerprint_unavailable">Hubungkan ke server terlebih dahulu untuk melihat sidik jari</string>
    <string name="cert_setup_done_button">Selesai — sertifikat terpasang</string>
    <string name="cert_setup_skip_button">Lewati dulu</string>
    <string name="cert_setup_skip_note">Anda dapat kembali ke panduan ini kapan saja dari Pengaturan.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Hubungkan ke komputer</string>
    <string name="connect_setup_subtitle">Perlu penyiapan sekali saja</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile terhubung ke aplikasi ChurchPresenter di komputer dalam jaringan lokal Anda. Pindai kode QR dari komputer agar koneksi dikonfigurasi otomatis.</string>
    <string name="connect_setup_step1_title">Buka ChurchPresenter di komputer Anda</string>
    <string name="connect_setup_step1_body">Jalankan aplikasi ChurchPresenter di komputer dan pastikan berjalan di jaringan Wi-Fi yang sama dengan perangkat ini.</string>
    <string name="connect_setup_step2_title">Tampilkan kode QR koneksi</string>
    <string name="connect_setup_step2_body">Di aplikasi komputer buka Pengaturan → Seluler lalu tekan “Show QR Code”. Kode QR berisi detail koneksi akan muncul di layar.</string>
    <string name="connect_setup_step3_title">Pindai kode QR di bawah</string>
    <string name="connect_setup_step3_body">Ketuk tombol di bawah untuk membuka kamera dan memindai kode QR yang tampil di komputer. Koneksi akan dikonfigurasi otomatis.</string>
    <string name="connect_setup_scan_button">Pindai kode QR</string>
    <string name="connect_setup_connected">✓ Terhubung ke %1$s:%2$s</string>
    <string name="connect_setup_done_button">Selesai — terhubung</string>
    <string name="connect_setup_skip_button">Lewati dulu</string>
    <string name="connect_setup_skip_note">Anda dapat memindai kode QR kapan saja dari Pengaturan.</string>

