    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Pagkatiwalaan ang sertipiko ng server</string>
    <string name="cert_setup_subtitle">Kailangan ng isang beses na setup</string>
    <string name="cert_setup_intro">Gumagamit ang ChurchPresenter ng pribadong HTTPS certificate para sa ligtas na komunikasyon. Kailangan mo itong i-install nang isang beses upang pagkatiwalaan ng device mo ang koneksyon.</string>
    <string name="cert_setup_scan_title">I-scan ang QR code ng sertipiko</string>
    <string name="cert_setup_scan_desktop_hint">Sa ChurchPresenter sa computer: Mga setting → Server → pindutin ang “Download Cert” para ipakita ang QR code.</string>
    <string name="cert_setup_scan_button">I-scan ang QR code</string>
    <string name="cert_setup_scan_or_divider">o gamitin ang naka-save na address</string>
    <string name="cert_setup_url_scanned">✓ Na-scan ang URL</string>
    <string name="cert_setup_url_label">URL ng sertipiko</string>
    <string name="cert_setup_open_button">Buksan ang URL ng sertipiko</string>
    <string name="cert_setup_step2_ios_title">iOS — I-install ang profile</string>
    <string name="cert_setup_step2_ios_body">Hihilingin ng Safari na i-download ang isang configuration profile. I-tap ang Payagan, pagkatapos ay pumunta sa Mga setting → Pangkalahatan → VPN at Pamamahala ng Device, i-tap ang ChurchPresenter at i-install.</string>
    <string name="cert_setup_step3_ios_title">iOS — Pagkatiwalaan ang sertipiko</string>
    <string name="cert_setup_step3_ios_body">Mga setting → Pangkalahatan → Tungkol sa → Mga setting ng tiwala sa sertipiko → i-on ang buong tiwala para sa ChurchPresenter CA.</string>
    <string name="cert_setup_step2_android_title">Android — I-install ang sertipiko</string>
    <string name="cert_setup_step2_android_body">Dina-download ng Chrome ang .crt file. I-tap ito mula sa notification ng download, piliin ang “CA Certificate” at bigyan ito ng pangalan tulad ng “ChurchPresenter”.</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ “Hindi makapag-install mula sa hindi kilalang pinagmulan”?</string>
    <string name="cert_setup_android_unknown_sources_body">Maaaring harangin ng Android ang pag-install kung hindi pinapayagan ang browser mo na mag-install ng mga file. Pumunta sa Mga setting → Apps → [browser mo] → Mag-install ng hindi kilalang apps, pagkatapos ay i-on ang “Payagan mula sa pinagmulang ito”. Bumalik dito at i-tap muli ang file.</string>
    <string name="cert_setup_fingerprint_title">I-verify ang fingerprint (inirerekomenda)</string>
    <string name="cert_setup_fingerprint_body">Ihambing ang fingerprint na ito sa ipinapakita ng ChurchPresenter sa computer sa Mga setting → Server → Certificate SHA-256. Dapat silang magtugma.</string>
    <string name="cert_setup_fingerprint_unavailable">Kumonekta muna sa server para makita ang fingerprint</string>
    <string name="cert_setup_done_button">Tapos na — na-install ang sertipiko</string>
    <string name="cert_setup_skip_button">Laktawan muna</string>
    <string name="cert_setup_skip_note">Puwede kang bumalik sa gabay na ito anumang oras mula sa Mga setting.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Kumonekta sa computer</string>
    <string name="connect_setup_subtitle">Kailangan ng isang beses na setup</string>
    <string name="connect_setup_intro">Kumokonekta ang ChurchPresenter Mobile sa ChurchPresenter app sa computer sa lokal mong network. I-scan ang QR code mula sa computer para awtomatikong ma-configure ang koneksyon.</string>
    <string name="connect_setup_step1_title">Buksan ang ChurchPresenter sa computer mo</string>
    <string name="connect_setup_step1_body">Ilunsad ang ChurchPresenter desktop app at tiyaking tumatakbo ito sa parehong Wi-Fi network ng device na ito.</string>
    <string name="connect_setup_step2_title">Ipakita ang QR code ng koneksyon</string>
    <string name="connect_setup_step2_body">Sa desktop app pumunta sa Mga setting → Mobile at pindutin ang “Show QR Code”. Lilitaw sa screen ang QR code na may detalye ng koneksyon.</string>
    <string name="connect_setup_step3_title">I-scan ang QR code sa ibaba</string>
    <string name="connect_setup_step3_body">I-tap ang button sa ibaba para buksan ang camera at i-scan ang QR code na ipinapakita sa computer. Awtomatikong mako-configure ang koneksyon.</string>
    <string name="connect_setup_scan_button">I-scan ang QR code</string>
    <string name="connect_setup_connected">✓ Nakakonekta sa %1$s:%2$s</string>
    <string name="connect_setup_done_button">Tapos na — nakakonekta</string>
    <string name="connect_setup_skip_button">Laktawan muna</string>
    <string name="connect_setup_skip_note">Puwede mong i-scan ang QR code anumang oras mula sa Mga setting.</string>

