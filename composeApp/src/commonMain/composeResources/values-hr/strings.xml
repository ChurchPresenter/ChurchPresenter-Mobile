    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Vjeruj certifikatu poslužitelja</string>
    <string name="cert_setup_subtitle">Potrebno je jednokratno postavljanje</string>
    <string name="cert_setup_intro">ChurchPresenter koristi privatni HTTPS certifikat za sigurnu komunikaciju. Morate ga jednom instalirati kako bi vaš uređaj vjerovao vezi.</string>
    <string name="cert_setup_scan_title">Skenirajte QR kod certifikata</string>
    <string name="cert_setup_scan_desktop_hint">U ChurchPresenteru na računalu: Postavke → Poslužitelj → pritisnite „Download Cert” za prikaz QR koda.</string>
    <string name="cert_setup_scan_button">Skeniraj QR kod</string>
    <string name="cert_setup_scan_or_divider">ili upotrijebi spremljenu adresu</string>
    <string name="cert_setup_url_scanned">✓ URL skeniran</string>
    <string name="cert_setup_url_label">URL certifikata</string>
    <string name="cert_setup_open_button">Otvori URL certifikata</string>
    <string name="cert_setup_step2_ios_title">iOS — Instalirajte profil</string>
    <string name="cert_setup_step2_ios_body">Safari će zatražiti preuzimanje konfiguracijskog profila. Dodirnite Dopusti, zatim idite na Postavke → Općenito → VPN i upravljanje uređajem, dodirnite ChurchPresenter i instalirajte.</string>
    <string name="cert_setup_step3_ios_title">iOS — Vjerujte certifikatu</string>
    <string name="cert_setup_step3_ios_body">Postavke → Općenito → Informacije → Postavke pouzdanosti certifikata → uključite puno povjerenje za ChurchPresenter CA.</string>
    <string name="cert_setup_step2_android_title">Android — Instalirajte certifikat</string>
    <string name="cert_setup_step2_android_body">Chrome preuzima .crt datoteku. Dodirnite je u obavijesti o preuzimanju, odaberite „CA certifikat” i dajte joj naziv poput „ChurchPresenter”.</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ „Nije moguće instalirati iz nepoznatih izvora”?</string>
    <string name="cert_setup_android_unknown_sources_body">Android može blokirati instalaciju ako preglednik nema dopuštenje instalirati datoteke. Idite na Postavke → Aplikacije → [vaš preglednik] → Instaliranje nepoznatih aplikacija i uključite „Dopusti iz ovog izvora”. Vratite se ovamo i ponovno dodirnite datoteku.</string>
    <string name="cert_setup_fingerprint_title">Provjerite otisak (preporučeno)</string>
    <string name="cert_setup_fingerprint_body">Usporedite ovaj otisak s onim koji ChurchPresenter na računalu prikazuje pod Postavke → Poslužitelj → Certificate SHA-256. Moraju se podudarati.</string>
    <string name="cert_setup_fingerprint_unavailable">Najprije se povežite s poslužiteljem da biste vidjeli otisak</string>
    <string name="cert_setup_done_button">Gotovo — certifikat instaliran</string>
    <string name="cert_setup_skip_button">Preskoči zasad</string>
    <string name="cert_setup_skip_note">Ovom vodiču možete se vratiti u bilo kojem trenutku iz Postavki.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Poveži se s računalom</string>
    <string name="connect_setup_subtitle">Potrebno je jednokratno postavljanje</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile povezuje se s aplikacijom ChurchPresenter na računalu u vašoj lokalnoj mreži. Skenirajte QR kod s računala kako bi se veza automatski postavila.</string>
    <string name="connect_setup_step1_title">Otvorite ChurchPresenter na računalu</string>
    <string name="connect_setup_step1_body">Pokrenite aplikaciju ChurchPresenter na računalu i provjerite da radi na istoj Wi-Fi mreži kao i ovaj uređaj.</string>
    <string name="connect_setup_step2_title">Prikažite QR kod za povezivanje</string>
    <string name="connect_setup_step2_body">U aplikaciji na računalu idite na Postavke → Mobilni uređaj i pritisnite „Show QR Code”. Na zaslonu će se pojaviti QR kod s podacima za povezivanje.</string>
    <string name="connect_setup_step3_title">Skenirajte QR kod ispod</string>
    <string name="connect_setup_step3_body">Dodirnite gumb ispod da biste otvorili kameru i skenirali QR kod prikazan na računalu. Veza će se postaviti automatski.</string>
    <string name="connect_setup_scan_button">Skeniraj QR kod</string>
    <string name="connect_setup_connected">✓ Povezano s %1$s:%2$s</string>
    <string name="connect_setup_done_button">Gotovo — povezano</string>
    <string name="connect_setup_skip_button">Preskoči zasad</string>
    <string name="connect_setup_skip_note">QR kod možete skenirati u bilo kojem trenutku iz Postavki.</string>

