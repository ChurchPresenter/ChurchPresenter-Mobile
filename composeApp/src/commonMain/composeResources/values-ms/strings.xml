    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Percayai sijil pelayan</string>
    <string name="cert_setup_subtitle">Persediaan sekali sahaja diperlukan</string>
    <string name="cert_setup_intro">ChurchPresenter menggunakan sijil HTTPS persendirian untuk komunikasi selamat. Anda perlu memasangnya sekali supaya peranti anda mempercayai sambungan ini.</string>
    <string name="cert_setup_scan_title">Imbas kod QR sijil</string>
    <string name="cert_setup_scan_desktop_hint">Dalam ChurchPresenter pada komputer: Tetapan → Pelayan → tekan “Download Cert” untuk memaparkan kod QR.</string>
    <string name="cert_setup_scan_button">Imbas kod QR</string>
    <string name="cert_setup_scan_or_divider">atau guna alamat yang disimpan</string>
    <string name="cert_setup_url_scanned">✓ URL diimbas</string>
    <string name="cert_setup_url_label">URL sijil</string>
    <string name="cert_setup_open_button">Buka URL sijil</string>
    <string name="cert_setup_step2_ios_title">iOS — Pasang profil</string>
    <string name="cert_setup_step2_ios_body">Safari akan meminta memuat turun profil konfigurasi. Ketik Benarkan, kemudian pergi ke Tetapan → Umum → VPN &amp; Pengurusan Peranti, ketik ChurchPresenter dan pasang.</string>
    <string name="cert_setup_step3_ios_title">iOS — Percayai sijil</string>
    <string name="cert_setup_step3_ios_body">Tetapan → Umum → Perihal → Tetapan Kepercayaan Sijil → hidupkan kepercayaan penuh untuk ChurchPresenter CA.</string>
    <string name="cert_setup_step2_android_title">Android — Pasang sijil</string>
    <string name="cert_setup_step2_android_body">Chrome memuat turun fail .crt. Ketik fail itu daripada pemberitahuan muat turun, pilih “Sijil CA” dan berikan nama seperti “ChurchPresenter”.</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ “Tidak boleh pasang daripada sumber tidak diketahui”?</string>
    <string name="cert_setup_android_unknown_sources_body">Android mungkin menyekat pemasangan jika pelayar anda tidak dibenarkan memasang fail. Pergi ke Tetapan → Apl → [pelayar anda] → Pasang apl tidak diketahui, kemudian hidupkan “Benarkan daripada sumber ini”. Kembali ke sini dan ketik fail itu semula.</string>
    <string name="cert_setup_fingerprint_title">Sahkan cap jari (disyorkan)</string>
    <string name="cert_setup_fingerprint_body">Bandingkan cap jari ini dengan yang dipaparkan ChurchPresenter pada komputer di Tetapan → Pelayan → Certificate SHA-256. Kedua-duanya mesti sepadan.</string>
    <string name="cert_setup_fingerprint_unavailable">Sambung ke pelayan dahulu untuk melihat cap jari</string>
    <string name="cert_setup_done_button">Selesai — sijil dipasang</string>
    <string name="cert_setup_skip_button">Langkau buat masa ini</string>
    <string name="cert_setup_skip_note">Anda boleh kembali ke panduan ini bila-bila masa daripada Tetapan.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Sambung ke komputer</string>
    <string name="connect_setup_subtitle">Persediaan sekali sahaja diperlukan</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile menyambung ke aplikasi ChurchPresenter pada komputer dalam rangkaian tempatan anda. Imbas kod QR daripada komputer untuk mengkonfigurasi sambungan secara automatik.</string>
    <string name="connect_setup_step1_title">Buka ChurchPresenter pada komputer anda</string>
    <string name="connect_setup_step1_body">Lancarkan aplikasi ChurchPresenter pada komputer dan pastikan ia berjalan pada rangkaian Wi-Fi yang sama dengan peranti ini.</string>
    <string name="connect_setup_step2_title">Paparkan kod QR sambungan</string>
    <string name="connect_setup_step2_body">Dalam aplikasi komputer pergi ke Tetapan → Mudah alih dan tekan “Show QR Code”. Kod QR dengan butiran sambungan akan muncul pada skrin.</string>
    <string name="connect_setup_step3_title">Imbas kod QR di bawah</string>
    <string name="connect_setup_step3_body">Ketik butang di bawah untuk membuka kamera dan mengimbas kod QR yang dipaparkan pada komputer. Sambungan akan dikonfigurasi secara automatik.</string>
    <string name="connect_setup_scan_button">Imbas kod QR</string>
    <string name="connect_setup_connected">✓ Disambungkan ke %1$s:%2$s</string>
    <string name="connect_setup_done_button">Selesai — disambungkan</string>
    <string name="connect_setup_skip_button">Langkau buat masa ini</string>
    <string name="connect_setup_skip_note">Anda boleh mengimbas kod QR bila-bila masa daripada Tetapan.</string>

