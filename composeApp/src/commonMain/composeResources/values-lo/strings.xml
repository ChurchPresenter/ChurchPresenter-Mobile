    <string name="cert_setup_android_unknown_sources_body">Android ອາດບລັອກການຕິດຕັ້ງຫາກບຣາວເຊີຂອງທ່ານບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ຕິດຕັ້ງໄຟລ໌. ໄປທີ່ ການຕັ້ງຄ່າ → ແອັບ → [ບຣາວເຊີຂອງທ່ານ] → ຕິດຕັ້ງແອັບທີ່ບໍ່ຮູ້ຈັກ ແລ້ວເປີດ “ອະນຸຍາດຈາກແຫຼ່ງນີ້”. ກັບມາທີ່ນີ້ແລ້ວແຕະໄຟລ໌ອີກຄັ້ງ.</string>
    <string name="cert_setup_fingerprint_title">ກວດສອບລາຍນິ້ວມື (ແນະນຳ)</string>
    <string name="cert_setup_fingerprint_body">ປຽບທຽບລາຍນິ້ວມືນີ້ກັບທີ່ ChurchPresenter ເທິງຄອມພິວເຕີສະແດງໃນ ການຕັ້ງຄ່າ → ເຊີບເວີ → Certificate SHA-256. ທັງສອງຕ້ອງກົງກັນ.</string>
    <string name="cert_setup_fingerprint_unavailable">ເຊື່ອມຕໍ່ກັບເຊີບເວີກ່ອນເພື່ອເບິ່ງລາຍນິ້ວມື</string>
    <string name="cert_setup_done_button">ສຳເລັດ — ຕິດຕັ້ງໃບຢັ້ງຢືນແລ້ວ</string>
    <string name="cert_setup_skip_button">ຂ້າມໄປກ່ອນ</string>
    <string name="cert_setup_skip_note">ທ່ານສາມາດກັບມາທີ່ຄູ່ມືນີ້ໄດ້ທຸກເມື່ອຈາກການຕັ້ງຄ່າ.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">ເຊື່ອມຕໍ່ກັບຄອມພິວເຕີ</string>
    <string name="connect_setup_subtitle">ຕ້ອງຕັ້ງຄ່າຄັ້ງດຽວ</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile ເຊື່ອມຕໍ່ກັບແອັບ ChurchPresenter ເທິງຄອມພິວເຕີໃນເຄືອຂ່າຍທ້ອງຖິ່ນຂອງທ່ານ. ສະແກນ QR ໂຄດຈາກຄອມພິວເຕີເພື່ອຕັ້ງຄ່າການເຊື່ອມຕໍ່ອັດຕະໂນມັດ.</string>
    <string name="connect_setup_step1_title">ເປີດ ChurchPresenter ໃນຄອມພິວເຕີຂອງທ່ານ</string>
    <string name="connect_setup_step1_body">ເປີດແອັບ ChurchPresenter ໃນຄອມພິວເຕີ ແລະ ກວດໃຫ້ແນ່ໃຈວ່າມັນຢູ່ໃນເຄືອຂ່າຍ Wi-Fi ດຽວກັນກັບອຸປະກອນນີ້.</string>
    <string name="connect_setup_step2_title">ສະແດງ QR ໂຄດການເຊື່ອມຕໍ່</string>
    <string name="connect_setup_step2_body">ໃນແອັບຄອມພິວເຕີໄປທີ່ ການຕັ້ງຄ່າ → ມືຖື ແລ້ວກົດ “Show QR Code”. QR ໂຄດພ້ອມລາຍລະອຽດການເຊື່ອມຕໍ່ຈະປາກົດເທິງຈໍ.</string>
    <string name="connect_setup_step3_title">ສະແກນ QR ໂຄດຂ້າງລຸ່ມ</string>
    <string name="connect_setup_step3_body">ແຕະປຸ່ມຂ້າງລຸ່ມເພື່ອເປີດກ້ອງ ແລະ ສະແກນ QR ໂຄດທີ່ສະແດງເທິງຄອມພິວເຕີ. ການເຊື່ອມຕໍ່ຈະຖືກຕັ້ງຄ່າອັດຕະໂນມັດ.</string>
    <string name="connect_setup_scan_button">ສະແກນ QR ໂຄດ</string>
    <string name="connect_setup_connected">✓ ເຊື່ອມຕໍ່ກັບ %1$s:%2$s ແລ້ວ</string>
    <string name="connect_setup_done_button">ສຳເລັດ — ເຊື່ອມຕໍ່ແລ້ວ</string>
    <string name="connect_setup_skip_button">ຂ້າມໄປກ່ອນ</string>
    <string name="connect_setup_skip_note">ທ່ານສາມາດສະແກນ QR ໂຄດໄດ້ທຸກເມື່ອຈາກການຕັ້ງຄ່າ.</string>

