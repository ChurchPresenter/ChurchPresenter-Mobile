    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Stol på serverens sertifikat</string>
    <string name="cert_setup_subtitle">Engangsoppsett kreves</string>
    <string name="cert_setup_intro">ChurchPresenter bruker et privat HTTPS-sertifikat for sikker kommunikasjon. Du må installere det én gang slik at enheten stoler på tilkoblingen.</string>
    <string name="cert_setup_scan_title">Skann sertifikatets QR-kode</string>
    <string name="cert_setup_scan_desktop_hint">I ChurchPresenter på datamaskinen: Innstillinger → Server → trykk «Download Cert» for å vise QR-koden.</string>
    <string name="cert_setup_scan_button">Skann QR-kode</string>
    <string name="cert_setup_scan_or_divider">eller bruk lagret adresse</string>
    <string name="cert_setup_url_scanned">✓ URL skannet</string>
    <string name="cert_setup_url_label">Sertifikatets URL</string>
    <string name="cert_setup_open_button">Åpne sertifikatets URL</string>
    <string name="cert_setup_step2_ios_title">iOS — Installer profilen</string>
    <string name="cert_setup_step2_ios_body">Safari spør om å laste ned en konfigurasjonsprofil. Trykk Tillat, gå så til Innstillinger → Generelt → VPN og enhetsadministrering, trykk ChurchPresenter og installer.</string>
    <string name="cert_setup_step3_ios_title">iOS — Stol på sertifikatet</string>
    <string name="cert_setup_step3_ios_body">Innstillinger → Generelt → Om → Innstillinger for sertifikattillit → slå på full tillit for ChurchPresenter CA.</string>
    <string name="cert_setup_step2_android_title">Android — Installer sertifikatet</string>
    <string name="cert_setup_step2_android_body">Chrome laster ned .crt-filen. Trykk på den i nedlastingsvarselet, velg «CA-sertifikat» og gi det et navn som «ChurchPresenter».</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ «Kan ikke installere fra ukjente kilder»?</string>
    <string name="cert_setup_android_unknown_sources_body">Android kan blokkere installasjonen hvis nettleseren ikke har lov til å installere filer. Gå til Innstillinger → Apper → [nettleseren din] → Installer ukjente apper, og slå på «Tillat fra denne kilden». Kom tilbake hit og trykk på filen igjen.</string>
    <string name="cert_setup_fingerprint_title">Bekreft fingeravtrykk (anbefalt)</string>
    <string name="cert_setup_fingerprint_body">Sammenlign dette fingeravtrykket med det ChurchPresenter på datamaskinen viser under Innstillinger → Server → Certificate SHA-256. De må stemme overens.</string>
    <string name="cert_setup_fingerprint_unavailable">Koble til serveren først for å se fingeravtrykket</string>
    <string name="cert_setup_done_button">Ferdig — sertifikatet er installert</string>
    <string name="cert_setup_skip_button">Hopp over foreløpig</string>
    <string name="cert_setup_skip_note">Du kan komme tilbake til denne veiledningen når som helst fra Innstillinger.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Koble til datamaskinen</string>
    <string name="connect_setup_subtitle">Engangsoppsett kreves</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile kobler seg til ChurchPresenter-appen på datamaskinen i det lokale nettverket. Skann QR-koden fra datamaskinen for å sette opp tilkoblingen automatisk.</string>
    <string name="connect_setup_step1_title">Åpne ChurchPresenter på datamaskinen</string>
    <string name="connect_setup_step1_body">Start ChurchPresenter på datamaskinen og sørg for at den kjører på samme Wi-Fi-nettverk som denne enheten.</string>
    <string name="connect_setup_step2_title">Vis tilkoblingens QR-kode</string>
    <string name="connect_setup_step2_body">Gå til Innstillinger → Mobil i appen på datamaskinen og trykk «Show QR Code». En QR-kode med tilkoblingsdetaljene vises på skjermen.</string>
    <string name="connect_setup_step3_title">Skann QR-koden nedenfor</string>
    <string name="connect_setup_step3_body">Trykk på knappen nedenfor for å åpne kameraet og skanne QR-koden som vises på datamaskinen. Tilkoblingen settes opp automatisk.</string>
    <string name="connect_setup_scan_button">Skann QR-kode</string>
    <string name="connect_setup_connected">✓ Koblet til %1$s:%2$s</string>
    <string name="connect_setup_done_button">Ferdig — tilkoblet</string>
    <string name="connect_setup_skip_button">Hopp over foreløpig</string>
    <string name="connect_setup_skip_note">Du kan skanne QR-koden når som helst fra Innstillinger.</string>

