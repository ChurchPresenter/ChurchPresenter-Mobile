    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">サーバー証明書を信頼する</string>
    <string name="cert_setup_subtitle">一度だけ設定が必要です</string>
    <string name="cert_setup_intro">ChurchPresenter は安全な通信のために独自の HTTPS 証明書を使用します。端末が接続を信頼するように、一度だけインストールする必要があります。</string>
    <string name="cert_setup_scan_title">証明書の QR コードをスキャン</string>
    <string name="cert_setup_scan_desktop_hint">パソコンの ChurchPresenter で: 設定 → サーバー →「Download Cert」を押すと QR コードが表示されます。</string>
    <string name="cert_setup_scan_button">QR コードをスキャン</string>
    <string name="cert_setup_scan_or_divider">または保存済みのアドレスを使用</string>
    <string name="cert_setup_url_scanned">✓ URL をスキャンしました</string>
    <string name="cert_setup_url_label">証明書の URL</string>
    <string name="cert_setup_open_button">証明書の URL を開く</string>
    <string name="cert_setup_step2_ios_title">iOS — プロファイルをインストール</string>
    <string name="cert_setup_step2_ios_body">Safari が構成プロファイルのダウンロードを求めます。「許可」をタップし、設定 → 一般 → VPN とデバイス管理 に進み、ChurchPresenter をタップしてインストールしてください。</string>
    <string name="cert_setup_step3_ios_title">iOS — 証明書を信頼する</string>
    <string name="cert_setup_step3_ios_body">設定 → 一般 → 情報 → 証明書信頼設定 → ChurchPresenter CA の完全な信頼を有効にしてください。</string>
    <string name="cert_setup_step2_android_title">Android — 証明書をインストール</string>
    <string name="cert_setup_step2_android_body">Chrome が .crt ファイルをダウンロードします。ダウンロード通知からタップし、「CA 証明書」を選んで「ChurchPresenter」などの名前を付けてください。</string>
    <string name="cert_setup_android_unknown_sources_title">⚠「不明なソースからインストールできません」と表示された場合</string>
    <string name="cert_setup_android_unknown_sources_body">ブラウザにファイルのインストールが許可されていないと、Android がインストールをブロックすることがあります。設定 → アプリ →［お使いのブラウザ］→ 不明なアプリのインストール に進み、「この提供元を許可」を有効にしてください。ここに戻ってもう一度ファイルをタップします。</string>
    <string name="cert_setup_fingerprint_title">フィンガープリントを確認（推奨）</string>
    <string name="cert_setup_fingerprint_body">このフィンガープリントを、パソコンの ChurchPresenter の 設定 → サーバー → Certificate SHA-256 に表示されるものと比べてください。一致している必要があります。</string>
    <string name="cert_setup_fingerprint_unavailable">フィンガープリントを表示するには、まずサーバーに接続してください</string>
    <string name="cert_setup_done_button">完了 — 証明書をインストールしました</string>
    <string name="cert_setup_skip_button">今はスキップ</string>
    <string name="cert_setup_skip_note">このガイドには設定からいつでも戻れます。</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">パソコンに接続</string>
    <string name="connect_setup_subtitle">一度だけ設定が必要です</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile はローカルネットワーク上のパソコンで動作する ChurchPresenter アプリに接続します。パソコンの QR コードをスキャンすると接続が自動で設定されます。</string>
    <string name="connect_setup_step1_title">パソコンで ChurchPresenter を開く</string>
    <string name="connect_setup_step1_body">パソコンで ChurchPresenter デスクトップアプリを起動し、この端末と同じ Wi-Fi ネットワークで動作していることを確認してください。</string>
    <string name="connect_setup_step2_title">接続用の QR コードを表示</string>
    <string name="connect_setup_step2_body">デスクトップアプリで 設定 → モバイル に進み、「Show QR Code」を押してください。接続情報を含む QR コードが画面に表示されます。</string>
    <string name="connect_setup_step3_title">下の QR コードをスキャン</string>
    <string name="connect_setup_step3_body">下のボタンをタップしてカメラを開き、パソコンに表示された QR コードをスキャンしてください。接続は自動で設定されます。</string>
    <string name="connect_setup_scan_button">QR コードをスキャン</string>
    <string name="connect_setup_connected">✓ %1$s:%2$s に接続しました</string>
    <string name="connect_setup_done_button">完了 — 接続しました</string>
    <string name="connect_setup_skip_button">今はスキップ</string>
    <string name="connect_setup_skip_note">QR コードは設定からいつでもスキャンできます。</string>

