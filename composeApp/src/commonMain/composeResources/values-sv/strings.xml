    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Lita på serverns certifikat</string>
    <string name="cert_setup_subtitle">Engångsinställning krävs</string>
    <string name="cert_setup_intro">ChurchPresenter använder ett privat HTTPS-certifikat för säker kommunikation. Du behöver installera det en gång så att enheten litar på anslutningen.</string>
    <string name="cert_setup_scan_title">Skanna certifikatets QR-kod</string>
    <string name="cert_setup_scan_desktop_hint">I ChurchPresenter på datorn: Inställningar → Server → tryck på ”Download Cert” för att visa QR-koden.</string>
    <string name="cert_setup_scan_button">Skanna QR-kod</string>
    <string name="cert_setup_scan_or_divider">eller använd sparad adress</string>
    <string name="cert_setup_url_scanned">✓ URL skannad</string>
    <string name="cert_setup_url_label">Certifikatets URL</string>
    <string name="cert_setup_open_button">Öppna certifikatets URL</string>
    <string name="cert_setup_step2_ios_title">iOS — Installera profilen</string>
    <string name="cert_setup_step2_ios_body">Safari frågar om en konfigurationsprofil ska laddas ned. Tryck på Tillåt, gå sedan till Inställningar → Allmänt → VPN och enhetshantering, tryck på ChurchPresenter och installera.</string>
    <string name="cert_setup_step3_ios_title">iOS — Lita på certifikatet</string>
    <string name="cert_setup_step3_ios_body">Inställningar → Allmänt → Om → Inställningar för certifikatförtroende → aktivera fullt förtroende för ChurchPresenter CA.</string>
    <string name="cert_setup_step2_android_title">Android — Installera certifikatet</string>
    <string name="cert_setup_step2_android_body">Chrome laddar ned .crt-filen. Tryck på den i nedladdningsaviseringen, välj ”CA-certifikat” och ge det ett namn som ”ChurchPresenter”.</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ ”Kan inte installera från okända källor”?</string>
    <string name="cert_setup_android_unknown_sources_body">Android kan blockera installationen om webbläsaren inte får installera filer. Gå till Inställningar → Appar → [din webbläsare] → Installera okända appar och aktivera ”Tillåt från denna källa”. Kom tillbaka hit och tryck på filen igen.</string>
    <string name="cert_setup_fingerprint_title">Verifiera fingeravtryck (rekommenderas)</string>
    <string name="cert_setup_fingerprint_body">Jämför detta fingeravtryck med det som ChurchPresenter på datorn visar under Inställningar → Server → Certificate SHA-256. De måste stämma överens.</string>
    <string name="cert_setup_fingerprint_unavailable">Anslut till servern först för att se fingeravtrycket</string>
    <string name="cert_setup_done_button">Klart — certifikatet installerat</string>
    <string name="cert_setup_skip_button">Hoppa över tills vidare</string>
    <string name="cert_setup_skip_note">Du kan återvända till den här guiden när som helst från Inställningar.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Anslut till datorn</string>
    <string name="connect_setup_subtitle">Engångsinställning krävs</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile ansluter till ChurchPresenter-appen på datorn i ditt lokala nätverk. Skanna QR-koden från datorn för att konfigurera anslutningen automatiskt.</string>
    <string name="connect_setup_step1_title">Öppna ChurchPresenter på datorn</string>
    <string name="connect_setup_step1_body">Starta ChurchPresenter på datorn och se till att den körs på samma Wi-Fi-nätverk som den här enheten.</string>
    <string name="connect_setup_step2_title">Visa anslutningens QR-kod</string>
    <string name="connect_setup_step2_body">Gå till Inställningar → Mobil i datorappen och tryck på ”Show QR Code”. En QR-kod med anslutningsuppgifterna visas på skärmen.</string>
    <string name="connect_setup_step3_title">Skanna QR-koden nedan</string>
    <string name="connect_setup_step3_body">Tryck på knappen nedan för att öppna kameran och skanna QR-koden på datorn. Anslutningen konfigureras automatiskt.</string>
    <string name="connect_setup_scan_button">Skanna QR-kod</string>
    <string name="connect_setup_connected">✓ Ansluten till %1$s:%2$s</string>
    <string name="connect_setup_done_button">Klart — ansluten</string>
    <string name="connect_setup_skip_button">Hoppa över tills vidare</string>
    <string name="connect_setup_skip_note">Du kan skanna QR-koden när som helst från Inställningar.</string>

