    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Luota palvelimen varmenteeseen</string>
    <string name="cert_setup_subtitle">Kertaluonteinen määritys tarvitaan</string>
    <string name="cert_setup_intro">ChurchPresenter käyttää yksityistä HTTPS-varmennetta turvalliseen viestintään. Sinun on asennettava se kerran, jotta laitteesi luottaa yhteyteen.</string>
    <string name="cert_setup_scan_title">Skannaa varmenteen QR-koodi</string>
    <string name="cert_setup_scan_desktop_hint">Tietokoneen ChurchPresenterissä: Asetukset → Palvelin → paina ”Download Cert” näyttääksesi QR-koodin.</string>
    <string name="cert_setup_scan_button">Skannaa QR-koodi</string>
    <string name="cert_setup_scan_or_divider">tai käytä tallennettua osoitetta</string>
    <string name="cert_setup_url_scanned">✓ URL skannattu</string>
    <string name="cert_setup_url_label">Varmenteen URL</string>
    <string name="cert_setup_open_button">Avaa varmenteen URL</string>
    <string name="cert_setup_step2_ios_title">iOS — Asenna profiili</string>
    <string name="cert_setup_step2_ios_body">Safari pyytää lataamaan määritysprofiilin. Napauta Salli ja siirry sitten kohtaan Asetukset → Yleiset → VPN ja laitehallinta, napauta ChurchPresenter ja asenna.</string>
    <string name="cert_setup_step3_ios_title">iOS — Luota varmenteeseen</string>
    <string name="cert_setup_step3_ios_body">Asetukset → Yleiset → Tietoja → Varmenneluottamusasetukset → ota täysi luottamus käyttöön ChurchPresenter CA:lle.</string>
    <string name="cert_setup_step2_android_title">Android — Asenna varmenne</string>
    <string name="cert_setup_step2_android_body">Chrome lataa .crt-tiedoston. Napauta sitä latausilmoituksesta, valitse ”CA-varmenne” ja anna sille nimi, esimerkiksi ”ChurchPresenter”.</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ ”Asennus tuntemattomista lähteistä ei onnistu”?</string>
    <string name="cert_setup_android_unknown_sources_body">Android voi estää asennuksen, jos selaimesi ei saa asentaa tiedostoja. Siirry kohtaan Asetukset → Sovellukset → [selaimesi] → Asenna tuntemattomia sovelluksia ja ota käyttöön ”Salli tästä lähteestä”. Palaa tänne ja napauta tiedostoa uudelleen.</string>
    <string name="cert_setup_fingerprint_title">Tarkista sormenjälki (suositeltavaa)</string>
    <string name="cert_setup_fingerprint_body">Vertaa tätä sormenjälkeä siihen, jonka tietokoneen ChurchPresenter näyttää kohdassa Asetukset → Palvelin → Certificate SHA-256. Niiden on täsmättävä.</string>
    <string name="cert_setup_fingerprint_unavailable">Yhdistä ensin palvelimeen nähdäksesi sormenjäljen</string>
    <string name="cert_setup_done_button">Valmis — varmenne asennettu</string>
    <string name="cert_setup_skip_button">Ohita toistaiseksi</string>
    <string name="cert_setup_skip_note">Voit palata tähän ohjeeseen milloin tahansa Asetuksista.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Yhdistä tietokoneeseen</string>
    <string name="connect_setup_subtitle">Kertaluonteinen määritys tarvitaan</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile yhdistyy tietokoneen ChurchPresenter-sovellukseen paikallisverkossa. Skannaa tietokoneen QR-koodi, niin yhteys määritetään automaattisesti.</string>
    <string name="connect_setup_step1_title">Avaa ChurchPresenter tietokoneellasi</string>
    <string name="connect_setup_step1_body">Käynnistä ChurchPresenter-sovellus tietokoneella ja varmista, että se on samassa Wi-Fi-verkossa kuin tämä laite.</string>
    <string name="connect_setup_step2_title">Näytä yhteyden QR-koodi</string>
    <string name="connect_setup_step2_body">Siirry tietokonesovelluksessa kohtaan Asetukset → Mobiili ja paina ”Show QR Code”. Näytölle ilmestyy QR-koodi, jossa on yhteystiedot.</string>
    <string name="connect_setup_step3_title">Skannaa alla oleva QR-koodi</string>
    <string name="connect_setup_step3_body">Napauta alla olevaa painiketta avataksesi kameran ja skannataksesi tietokoneen näytöllä olevan QR-koodin. Yhteys määritetään automaattisesti.</string>
    <string name="connect_setup_scan_button">Skannaa QR-koodi</string>
    <string name="connect_setup_connected">✓ Yhdistetty kohteeseen %1$s:%2$s</string>
    <string name="connect_setup_done_button">Valmis — yhdistetty</string>
    <string name="connect_setup_skip_button">Ohita toistaiseksi</string>
    <string name="connect_setup_skip_note">Voit skannata QR-koodin milloin tahansa Asetuksista.</string>

