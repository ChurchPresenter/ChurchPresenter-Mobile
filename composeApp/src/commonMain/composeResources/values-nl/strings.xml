    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Servercertificaat vertrouwen</string>
    <string name="cert_setup_subtitle">Eenmalige installatie vereist</string>
    <string name="cert_setup_intro">ChurchPresenter gebruikt een privé HTTPS-certificaat voor veilige communicatie. Je moet het eenmalig installeren zodat je apparaat de verbinding vertrouwt.</string>
    <string name="cert_setup_scan_title">Scan de QR-code van het certificaat</string>
    <string name="cert_setup_scan_desktop_hint">In ChurchPresenter desktop: Instellingen → Server → druk op \"Download Cert\" om de QR-code te tonen.</string>
    <string name="cert_setup_scan_button">QR-code scannen</string>
    <string name="cert_setup_scan_or_divider">of gebruik opgeslagen adres</string>
    <string name="cert_setup_url_scanned">✓ URL gescand</string>
    <string name="cert_setup_url_label">Certificaat-URL</string>
    <string name="cert_setup_open_button">Certificaat-URL openen</string>
    <string name="cert_setup_step2_ios_title">iOS — Installeer het profiel</string>
    <string name="cert_setup_step2_ios_body">Safari vraagt om een configuratieprofiel te downloaden. Tik op Toestaan, ga daarna naar Instellingen → Algemeen → VPN &amp; apparaatbeheer, tik op ChurchPresenter en installeer.</string>
    <string name="cert_setup_step3_ios_title">iOS — Vertrouw het certificaat</string>
    <string name="cert_setup_step3_ios_body">Instellingen → Algemeen → Info → Certificaatvertrouwensinstellingen → schakel volledig vertrouwen in voor ChurchPresenter CA.</string>
    <string name="cert_setup_step2_android_title">Android — Installeer het certificaat</string>
    <string name="cert_setup_step2_android_body">Chrome downloadt het .crt-bestand. Tik erop vanuit de downloadmelding, kies \"CA-certificaat\" en geef het een naam zoals \"ChurchPresenter\".</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ \"Kan niet installeren vanuit onbekende bronnen\"?</string>
    <string name="cert_setup_android_unknown_sources_body">Android kan de installatie blokkeren als je browser geen bestanden mag installeren. Ga naar Instellingen → Apps → [je browser] → Onbekende apps installeren en schakel \"Toestaan vanuit deze bron\" in. Kom hier terug en tik het bestand opnieuw aan.</string>
    <string name="cert_setup_fingerprint_title">Vingerafdruk verifiëren (aanbevolen)</string>
    <string name="cert_setup_fingerprint_body">Vergelijk deze vingerafdruk met wat ChurchPresenter desktop toont in Instellingen → Server → Certificaat SHA-256. Ze moeten overeenkomen.</string>
    <string name="cert_setup_fingerprint_unavailable">Maak eerst verbinding met de server om de vingerafdruk te zien</string>
    <string name="cert_setup_done_button">Klaar — Certificaat geïnstalleerd</string>
    <string name="cert_setup_skip_button">Nu overslaan</string>
    <string name="cert_setup_skip_note">Je kunt op elk moment terugkeren naar deze handleiding vanuit Instellingen.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Verbinden met desktop</string>
    <string name="connect_setup_subtitle">Eenmalige installatie vereist</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile verbindt met de ChurchPresenter desktop-app op je lokale netwerk. Scan de QR-code van de desktop om de verbinding automatisch te configureren.</string>
    <string name="connect_setup_skip_button">Nu overslaan</string>
    <string name="connect_setup_done_button">Klaar — Verbonden</string>
    <string name="connect_setup_skip_note">Je kunt de QR-code op elk moment scannen vanuit Instellingen.</string>
    <string name="connect_setup_step1_title">Open ChurchPresenter op je computer</string>
    <string name="connect_setup_step1_body">Start de ChurchPresenter desktop-applicatie en zorg dat deze op hetzelfde Wi-Fi-netwerk draait als dit apparaat.</string>
    <string name="connect_setup_step2_title">Toon de verbindings-QR-code</string>
    <string name="connect_setup_step2_body">Ga in de desktop-app naar Instellingen → Mobiel → en druk op \"QR-code tonen\". Een QR-code met de verbindingsgegevens verschijnt op het scherm.</string>
    <string name="connect_setup_step3_title">Scan de QR-code hieronder</string>
    <string name="connect_setup_step3_body">Tik op de knop hieronder om de camera te openen en de QR-code op de desktop te scannen. De verbinding wordt automatisch geconfigureerd.</string>
    <string name="connect_setup_scan_button">QR-code scannen</string>
    <string name="connect_setup_connected">✓ Verbonden met %1$s:%2$s</string>
    <string name="connect_setup_no_camera_note">Geen camera gedetecteerd op dit apparaat. Voer de verbindingsgegevens handmatig in:</string>
