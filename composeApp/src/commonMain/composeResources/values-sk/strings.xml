    <string name="status_warn_no_songbooks_body">Server nemá načítané žiadne spevníky. Karta Piesne bude prázdna. Importujte spevník v aplikácii ChurchPresenter na počítači.</string>
    <string name="status_warn_present_blocked_title">Ovládanie prezentácie zablokované</string>
    <string name="status_warn_present_blocked_body">Toto zariadenie nemá povolenie ovládať prezentáciu (premietať, mazať, vyberať snímky). Požiadajte správcu servera o udelenie oprávnenia Prezentér tomuto zariadeniu.</string>
    <string name="status_warn_schedule_blocked_title">Úprava programu zablokovaná</string>
    <string name="status_warn_schedule_blocked_body">Toto zariadenie nemá povolenie pridávať položky do programu. Požiadajte správcu servera o udelenie oprávnenia Program tomuto zariadeniu.</string>
    <string name="status_warn_upload_blocked_title">Nahrávanie súborov zablokované</string>
    <string name="status_warn_upload_blocked_body">Toto zariadenie nemá povolenie nahrávať prezentácie alebo obrázky. Požiadajte správcu servera o udelenie oprávnenia Nahrávanie tomuto zariadeniu.</string>
    <string name="upload_blocked_toast">Nahrávanie súborov je pre toto zariadenie vypnuté. Požiadajte správcu servera o udelenie oprávnenia Nahrávanie.</string>
