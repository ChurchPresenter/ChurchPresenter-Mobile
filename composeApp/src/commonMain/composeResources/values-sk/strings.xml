    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">Dôverovať certifikátu servera</string>
    <string name="cert_setup_subtitle">Vyžaduje sa jednorazové nastavenie</string>
    <string name="cert_setup_intro">ChurchPresenter používa súkromný HTTPS certifikát pre bezpečnú komunikáciu. Musíte ho jednorazovo nainštalovať, aby vaše zariadenie dôverovalo pripojeniu.</string>
    <string name="cert_setup_scan_title">Naskenujte QR kód certifikátu</string>
    <string name="cert_setup_scan_desktop_hint">Na počítači v ChurchPresenter: Nastavenia → Server → stlačte \"Stiahnuť cert\" pre zobrazenie QR kódu.</string>
    <string name="cert_setup_scan_button">Naskenovať QR kód</string>
    <string name="cert_setup_scan_or_divider">alebo použiť uloženú adresu</string>
    <string name="cert_setup_url_scanned">✓ URL naskenovaná</string>
    <string name="cert_setup_url_label">URL certifikátu</string>
    <string name="cert_setup_open_button">Otvoriť URL certifikátu</string>
    <string name="cert_setup_step2_ios_title">iOS — Nainštalujte profil</string>
    <string name="cert_setup_step2_ios_body">Safari požiada o stiahnutie konfiguračného profilu. Ťuknite na Povoliť, potom prejdite do Nastavenia → Všeobecné → VPN a správa zariadenia, ťuknite na ChurchPresenter a nainštalujte.</string>
    <string name="cert_setup_step3_ios_title">iOS — Dôverovať certifikátu</string>
    <string name="cert_setup_step3_ios_body">Nastavenia → Všeobecné → Informácie → Nastavenia dôvery certifikátov → povoľte plnú dôveru pre ChurchPresenter CA.</string>
    <string name="cert_setup_step2_android_title">Android — Nainštalujte certifikát</string>
    <string name="cert_setup_step2_android_body">Chrome stiahne súbor .crt. Ťuknite naň z upozornenia v priečinku Stiahnuté, vyberte \"CA certifikát\" a pomenujte ho napríklad \"ChurchPresenter\".</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ \"Nedá sa nainštalovať z neznámych zdrojov\"?</string>
    <string name="cert_setup_android_unknown_sources_body">Android môže zablokovať inštaláciu, ak váš prehliadač nemá povolené inštalovať súbory. Prejdite do Nastavenia → Aplikácie → [váš prehliadač] → Inštalovať neznáme aplikácie, potom povoľte \"Povoliť z tohto zdroja\". Vráťte sa sem a znova ťuknite na súbor.</string>
    <string name="cert_setup_fingerprint_title">Overiť odtlačok (odporúčané)</string>
    <string name="cert_setup_fingerprint_body">Porovnajte tento odtlačok s tým, čo ChurchPresenter na počítači zobrazuje v Nastavenia → Server → Certifikát SHA-256. Musia sa zhodovať.</string>
    <string name="cert_setup_fingerprint_unavailable">Najprv sa pripojte k serveru, aby ste videli odtlačok</string>
    <string name="cert_setup_done_button">Hotovo — Certifikát nainštalovaný</string>
    <string name="cert_setup_skip_button">Preskočiť zatiaľ</string>
    <string name="cert_setup_skip_note">K tomuto sprievodcovi sa môžete kedykoľvek vrátiť z Nastavení.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">Pripojiť k počítaču</string>
    <string name="connect_setup_subtitle">Vyžaduje sa jednorazové nastavenie</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile sa pripája k aplikácii ChurchPresenter na počítači vo vašej lokálnej sieti. Naskenujte QR kód z počítača pre automatické nastavenie pripojenia.</string>
    <string name="connect_setup_skip_button">Preskočiť zatiaľ</string>
    <string name="connect_setup_done_button">Hotovo — Pripojené</string>
    <string name="connect_setup_skip_note">QR kód môžete naskenovať kedykoľvek z Nastavení.</string>
    <string name="connect_setup_step1_title">Otvorte ChurchPresenter na svojom počítači</string>
    <string name="connect_setup_step1_body">Spustite aplikáciu ChurchPresenter na počítači a uistite sa, že beží v rovnakej sieti Wi-Fi ako toto zariadenie.</string>
    <string name="connect_setup_step2_title">Zobrazte QR kód pripojenia</string>
    <string name="connect_setup_step2_body">V aplikácii na počítači prejdite do Nastavenia → Mobil → a stlačte \"Zobraziť QR kód\". Na obrazovke sa zobrazí QR kód s údajmi o pripojení.</string>
    <string name="connect_setup_step3_title">Naskenujte QR kód nižšie</string>
    <string name="connect_setup_step3_body">Ťuknite na tlačidlo nižšie pre otvorenie fotoaparátu a naskenovanie QR kódu zobrazeného na počítači. Pripojenie sa nastaví automaticky.</string>
    <string name="connect_setup_scan_button">Naskenovať QR kód</string>
    <string name="connect_setup_connected">✓ Pripojené k %1$s:%2$s</string>
    <string name="connect_setup_no_camera_note">Na tomto zariadení nebol zistený žiadny fotoaparát. Zadajte údaje o pripojení manuálne:</string>
    <string name="connect_setup_manual_entry_toggle">Zadať manuálne namiesto toho</string>
    <string name="connect_setup_scan_instead_toggle">Naskenovať QR kód namiesto toho</string>
