    <string name="status_warn_no_api_key_title">Nie je nakonfigurovaný žiadny API kľúč</string>
    <string name="status_warn_no_api_key_body">Server nemá nastavený žiadny API kľúč. Niektoré chránené koncové body môžu odmietnuť požiadavky. Zvážte povolenie API kľúča v nastaveniach servera ChurchPresenter.</string>
