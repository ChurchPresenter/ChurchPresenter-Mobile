    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">सर्भर प्रमाणपत्रमा विश्वास गर्नुहोस्</string>
    <string name="cert_setup_subtitle">एक पटकको सेटअप आवश्यक छ</string>
    <string name="cert_setup_intro">ChurchPresenter ले सुरक्षित सञ्चारका लागि निजी HTTPS प्रमाणपत्र प्रयोग गर्छ। तपाईंको यन्त्रले जडानमा विश्वास गरोस् भनेर यसलाई एक पटक स्थापना गर्नुपर्छ।</string>
    <string name="cert_setup_scan_title">प्रमाणपत्रको QR कोड स्क्यान गर्नुहोस्</string>
    <string name="cert_setup_scan_desktop_hint">कम्प्युटरको ChurchPresenter मा: सेटिङ → सर्भर → QR कोड देखाउन “Download Cert” थिच्नुहोस्।</string>
    <string name="cert_setup_scan_button">QR कोड स्क्यान गर्नुहोस्</string>
    <string name="cert_setup_scan_or_divider">वा सुरक्षित गरिएको ठेगाना प्रयोग गर्नुहोस्</string>
    <string name="cert_setup_url_scanned">✓ URL स्क्यान गरियो</string>
    <string name="cert_setup_url_label">प्रमाणपत्र URL</string>
    <string name="cert_setup_open_button">प्रमाणपत्र URL खोल्नुहोस्</string>
    <string name="cert_setup_step2_ios_title">iOS — प्रोफाइल स्थापना गर्नुहोस्</string>
    <string name="cert_setup_step2_ios_body">Safari ले कन्फिगरेसन प्रोफाइल डाउनलोड गर्न सोध्नेछ। अनुमति दिनुहोस् थिच्नुहोस्, त्यसपछि सेटिङ → सामान्य → VPN र यन्त्र व्यवस्थापन मा जानुहोस्, ChurchPresenter थिच्नुहोस् र स्थापना गर्नुहोस्।</string>
    <string name="cert_setup_step3_ios_title">iOS — प्रमाणपत्रमा विश्वास गर्नुहोस्</string>
    <string name="cert_setup_step3_ios_body">सेटिङ → सामान्य → बारेमा → प्रमाणपत्र विश्वास सेटिङ → ChurchPresenter CA का लागि पूर्ण विश्वास सक्षम गर्नुहोस्।</string>
    <string name="cert_setup_step2_android_title">Android — प्रमाणपत्र स्थापना गर्नुहोस्</string>
    <string name="cert_setup_step2_android_body">Chrome ले .crt फाइल डाउनलोड गर्छ। डाउनलोड सूचनाबाट त्यसमा थिच्नुहोस्, “CA प्रमाणपत्र” छान्नुहोस् र “ChurchPresenter” जस्तो नाम दिनुहोस्।</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ “अज्ञात स्रोतबाट स्थापना गर्न सकिँदैन”?</string>
    <string name="cert_setup_android_unknown_sources_body">तपाईंको ब्राउजरलाई फाइल स्थापना गर्ने अनुमति नभएमा Android ले स्थापना रोक्न सक्छ। सेटिङ → एपहरू → [तपाईंको ब्राउजर] → अज्ञात एप स्थापना गर्नुहोस् मा जानुहोस्, त्यसपछि “यो स्रोतबाट अनुमति दिनुहोस्” सक्षम गर्नुहोस्। यहाँ फर्केर फाइलमा फेरि थिच्नुहोस्।</string>
    <string name="cert_setup_fingerprint_title">फिंगरप्रिन्ट प्रमाणित गर्नुहोस् (सिफारिस गरिएको)</string>
    <string name="cert_setup_fingerprint_body">यो फिंगरप्रिन्टलाई कम्प्युटरको ChurchPresenter ले सेटिङ → सर्भर → Certificate SHA-256 मा देखाउने सँग तुलना गर्नुहोस्। दुवै मिल्नुपर्छ।</string>
    <string name="cert_setup_fingerprint_unavailable">फिंगरप्रिन्ट हेर्न पहिले सर्भरमा जडान गर्नुहोस्</string>
    <string name="cert_setup_done_button">सम्पन्न — प्रमाणपत्र स्थापना भयो</string>
    <string name="cert_setup_skip_button">अहिलेलाई छोड्नुहोस्</string>
    <string name="cert_setup_skip_note">तपाईं यो निर्देशिकामा सेटिङबाट जुनसुकै बेला फर्कन सक्नुहुन्छ।</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">कम्प्युटरमा जडान गर्नुहोस्</string>
    <string name="connect_setup_subtitle">एक पटकको सेटअप आवश्यक छ</string>
    <string name="connect_setup_intro">ChurchPresenter Mobile तपाईंको स्थानीय सञ्जालमा रहेको कम्प्युटरको ChurchPresenter एपमा जडान हुन्छ। जडान स्वतः मिलाउन कम्प्युटरको QR कोड स्क्यान गर्नुहोस्।</string>
    <string name="connect_setup_step1_title">आफ्नो कम्प्युटरमा ChurchPresenter खोल्नुहोस्</string>
    <string name="connect_setup_step1_body">कम्प्युटरमा ChurchPresenter डेस्कटप एप चलाउनुहोस् र यो यन्त्रसँगै उही Wi-Fi सञ्जालमा छ भन्ने सुनिश्चित गर्नुहोस्।</string>
    <string name="connect_setup_step2_title">जडानको QR कोड देखाउनुहोस्</string>
    <string name="connect_setup_step2_body">डेस्कटप एपमा सेटिङ → मोबाइल मा जानुहोस् र “Show QR Code” थिच्नुहोस्। जडान विवरणसहितको QR कोड पर्दामा देखिनेछ।</string>
    <string name="connect_setup_step3_title">तलको QR कोड स्क्यान गर्नुहोस्</string>
    <string name="connect_setup_step3_body">क्यामेरा खोल्न र कम्प्युटरमा देखिएको QR कोड स्क्यान गर्न तलको बटन थिच्नुहोस्। जडान स्वतः मिलाइनेछ।</string>
    <string name="connect_setup_scan_button">QR कोड स्क्यान गर्नुहोस्</string>
    <string name="connect_setup_connected">✓ %1$s:%2$s मा जडान भयो</string>
