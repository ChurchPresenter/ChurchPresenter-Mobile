    <!-- Certificate Setup Screen -->
    <string name="cert_setup_title">الوثوق بشهادة الخادم</string>
    <string name="cert_setup_subtitle">مطلوب إعداد لمرة واحدة</string>
    <string name="cert_setup_intro">يستخدم ChurchPresenter شهادة HTTPS خاصة لتأمين الاتصال. عليك تثبيتها مرة واحدة ليثق جهازك بهذا الاتصال.</string>
    <string name="cert_setup_scan_title">امسح رمز QR الخاص بالشهادة</string>
    <string name="cert_setup_scan_desktop_hint">في ChurchPresenter على الحاسوب: الإعدادات ← الخادم ← اضغط «Download Cert» لإظهار رمز QR.</string>
    <string name="cert_setup_scan_button">امسح رمز QR</string>
    <string name="cert_setup_scan_or_divider">أو استخدم العنوان المحفوظ</string>
    <string name="cert_setup_url_scanned">✓ تم مسح الرابط</string>
    <string name="cert_setup_url_label">رابط الشهادة</string>
    <string name="cert_setup_open_button">افتح رابط الشهادة</string>
    <string name="cert_setup_step2_ios_title">iOS — ثبّت ملف التعريف</string>
    <string name="cert_setup_step2_ios_body">سيطلب Safari تنزيل ملف تعريف الإعداد. اضغط «سماح»، ثم انتقل إلى الإعدادات ← عام ← VPN وإدارة الجهاز، واضغط ChurchPresenter وثبّته.</string>
    <string name="cert_setup_step3_ios_title">iOS — ثق بالشهادة</string>
    <string name="cert_setup_step3_ios_body">الإعدادات ← عام ← حول ← إعدادات الثقة بالشهادات ← فعّل الثقة الكاملة لـ ChurchPresenter CA.</string>
    <string name="cert_setup_step2_android_title">Android — ثبّت الشهادة</string>
    <string name="cert_setup_step2_android_body">ينزّل Chrome ملف ‎.crt. اضغط عليه من إشعار التنزيل، واختر «شهادة CA» وسمّه باسم مثل «ChurchPresenter».</string>
    <string name="cert_setup_android_unknown_sources_title">⚠ ظهرت رسالة «تعذّر التثبيت من مصادر غير معروفة»؟</string>
    <string name="cert_setup_android_unknown_sources_body">قد يحظر Android التثبيت إذا لم يكن متصفحك مسموحًا له بتثبيت الملفات. انتقل إلى الإعدادات ← التطبيقات ← [متصفحك] ← تثبيت تطبيقات غير معروفة، ثم فعّل «السماح من هذا المصدر». ارجع إلى هنا واضغط الملف مرة أخرى.</string>
    <string name="cert_setup_fingerprint_title">تحقّق من البصمة (موصى به)</string>
    <string name="cert_setup_fingerprint_body">قارن هذه البصمة بما يعرضه ChurchPresenter على الحاسوب في الإعدادات ← الخادم ← Certificate SHA-256. يجب أن تتطابقا.</string>
    <string name="cert_setup_fingerprint_unavailable">اتصل بالخادم أولًا لرؤية البصمة</string>
    <string name="cert_setup_done_button">تم — تم تثبيت الشهادة</string>
    <string name="cert_setup_skip_button">تخطَّ الآن</string>
    <string name="cert_setup_skip_note">يمكنك العودة إلى هذا الدليل في أي وقت من الإعدادات.</string>

    <!-- Connect Setup Screen -->
    <string name="connect_setup_title">الاتصال بالحاسوب</string>
    <string name="connect_setup_subtitle">مطلوب إعداد لمرة واحدة</string>
    <string name="connect_setup_intro">يتصل ChurchPresenter Mobile بتطبيق ChurchPresenter على الحاسوب في شبكتك المحلية. امسح رمز QR من الحاسوب لضبط الاتصال تلقائيًا.</string>
    <string name="connect_setup_step1_title">افتح ChurchPresenter على حاسوبك</string>
    <string name="connect_setup_step1_body">شغّل تطبيق ChurchPresenter على الحاسوب وتأكد أنه يعمل على شبكة Wi-Fi نفسها التي يستخدمها هذا الجهاز.</string>
    <string name="connect_setup_step2_title">أظهر رمز QR للاتصال</string>
    <string name="connect_setup_step2_body">في تطبيق الحاسوب انتقل إلى الإعدادات ← الجوال واضغط «Show QR Code». سيظهر على الشاشة رمز QR يحمل تفاصيل الاتصال.</string>
    <string name="connect_setup_step3_title">امسح رمز QR أدناه</string>
    <string name="connect_setup_step3_body">اضغط الزر أدناه لفتح الكاميرا ومسح رمز QR المعروض على الحاسوب. سيُضبط الاتصال تلقائيًا.</string>
    <string name="connect_setup_scan_button">امسح رمز QR</string>
    <string name="connect_setup_connected">✓ تم الاتصال بـ %1$s:%2$s</string>
    <string name="connect_setup_done_button">تم — تم الاتصال</string>
    <string name="connect_setup_skip_button">تخطَّ الآن</string>
    <string name="connect_setup_skip_note">يمكنك مسح رمز QR في أي وقت من الإعدادات.</string>

