<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Required on Android 13+ (API 33+) to show push notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!--
        Standalone presenting: the phone hosts an HTTP/WebSocket server that TVs
        on the LAN connect to. Without a foreground service plus these two locks,
        Android suspends the CPU and puts Wi-Fi into power-saving once the screen
        is off, and the audience screen drops out mid-song.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
            android:name=".ChurchPresenterApp"
            android:allowBackup="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:networkSecurityConfig="@xml/network_security_config">

        <!--
            Tells the Firebase SDK which channel to use when it auto-displays
            a notification message while the app is in the background or killed.
            Without this the notification is silently dropped on Android 8+.
        -->
        <meta-data
                android:name="com.google.firebase.messaging.default_notification_channel_id"
                android:value="church_presenter_channel"/>

        <!--
            Disable Sentry's auto-init ContentProvider. It runs before
            Application.onCreate and would look for the DSN in an io.sentry.dsn
            manifest meta-data entry — which we don't set. Instead we init Sentry
            manually in ChurchPresenterApp.onCreate (CrashReporting.initSentry),
            where the DSN comes from SentryConfig.kt. Without this, auto-init
            crashes at startup with "DSN is required".
        -->
        <meta-data
                android:name="io.sentry.auto-init"
                android:value="false"/>

        <!--
            Disable automatic Activity-class screen tracking. We manually call
            Analytics.logScreenView() with friendly names at every navigation point
            so the Firebase "Pages and screens" report shows meaningful screen names.
        -->
        <meta-data
                android:name="google_analytics_automatic_screen_reporting_enabled"
                android:value="false"/>

        <activity
                android:exported="true"
                android:name=".MainActivity"
                android:launchMode="singleTask"
                android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- churchpresenter://connect?host=…&port=…&apikey=… deep links -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="churchpresenter"/>
            </intent-filter>
            <!--
                Opening a shared .cpset or ChordPro file from Files, email, or a
                messaging app. pathPattern needs the doubled escapes: Android
                matches the literal path, and "\\." is a literal dot.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="content"/>
                <data android:scheme="file"/>
                <data android:mimeType="*/*"/>
                <data android:host="*"/>
                <data android:pathPattern=".*\\.cpset"/>
                <data android:pathPattern=".*\\.cho"/>
                <data android:pathPattern=".*\\.chordpro"/>
                <data android:pathPattern=".*\\.chopro"/>
            </intent-filter>
            <!-- Receiving a song or set shared from another app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/json"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- Static app shortcuts (Songs + Bible) shown on home-screen long-press -->
            <meta-data
                    android:name="android.app.shortcuts"
                    android:resource="@xml/shortcuts"/>
        </activity>

        <!--
            Keeps the standalone presentation server running while the app is
            backgrounded or the screen is off.

            foregroundServiceType="specialUse" because none of Android's typed
            categories fit "host a LAN server for the screens in this room" —
            dataSync is the closest but is quota-limited on Android 15, which
            would cut a long service short. The subtype value below is what the
            Play Console review asks for.
        -->
        <service
                android:name=".service.PresentationForegroundService"
                android:exported="false"
                android:foregroundServiceType="specialUse">
            <property
                    android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                    android:value="local_presentation_server"/>
        </service>

        <!--
            Serves exported files to the share sheet from the app's own cache,
            so no storage permission is needed.
        -->
        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths"/>
        </provider>

        <!-- Firebase Cloud Messaging receiver -->
        <service
                android:name=".service.FirebasePushService"
                android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
    </application>

</manifest>