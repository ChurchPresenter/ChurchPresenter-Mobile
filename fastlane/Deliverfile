# App Store listing text and What's New for every localization, uploaded with `fastlane deliver`.
# Text only: the binary goes up through Store Release, screenshots by hand.
#
# Run by the "App Store Metadata" workflow (.github/workflows/ios-metadata.yml),
# or locally — see APP_STORE.md, "Localized listings".

app_identifier("com.church.presenter.churchpresentermobile")
platform("ios")
metadata_path("./fastlane/metadata")

skip_binary_upload(true)
skip_screenshots(true)
submit_for_review(false)

# Precheck cannot read in-app purchases with an API key and fails the run after the upload is done;
# it only matters for a submission, which this never makes.
run_precheck_before_submit(false)

# Skips the HTML preview prompt, which a CI run cannot answer.
force(true)
